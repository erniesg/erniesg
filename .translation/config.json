    },
    "codex-cli": {
      "requiresEnv": [],
      "supportsStructuredJson": true,
      "supportsWebResearch": true,
      "supportsSourceAnnotations": true
    }
  },
  "reviewCache": {
    "enabled": true,
    "reuseWhenHashesMatch": true,
