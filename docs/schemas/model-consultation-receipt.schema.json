{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ernie.sg/schemas/model-consultation-receipt-1.0.0.json",
  "title": "Deterministic candidate-constrained model consultation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "sourceSha256",
    "consultations",
    "decisions",
    "metrics"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "documentId": { "$ref": "#/$defs/id" },
    "sourceSha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "consultations": {
      "type": "array",
      "items": { "$ref": "#/$defs/consultation" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/id" },
        "associationId": { "$ref": "#/$defs/id" },
        "order": { "type": "number" },
        "label": { "type": "string" }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "modelId", "modelVersion", "modelDigest"],
      "properties": {
        "providerId": { "$ref": "#/$defs/id" },
        "modelId": { "$ref": "#/$defs/id" },
        "modelVersion": { "$ref": "#/$defs/id" },
        "modelDigest": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "$ref": "#/$defs/id" }]
        }
      }
    },
    "consultation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "fixtureId",
        "documentId",
        "decisionId",
        "decisionClass",
        "sourceSha256",
        "inputs",
        "inputsHash",
        "candidates",
        "candidateIds",
        "model",
        "promptHash",
        "status",
        "choice",
        "costUsd",
        "latencyMs"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "requestId": { "$ref": "#/$defs/sha256" },
        "fixtureId": { "$ref": "#/$defs/id" },
        "documentId": { "$ref": "#/$defs/id" },
        "decisionId": { "$ref": "#/$defs/id" },
        "decisionClass": { "$ref": "#/$defs/id" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "inputs": { "type": "object" },
        "inputsHash": { "$ref": "#/$defs/sha256" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "model": { "$ref": "#/$defs/model" },
        "promptHash": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["pending", "accepted", "rejected", "failed"] },
        "choice": {
          "anyOf": [{ "$ref": "#/$defs/choice" }, { "type": "null" }]
        },
        "costUsd": { "type": "number", "minimum": 0 },
        "latencyMs": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "failureCode": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "accepted" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "choice": { "$ref": "#/$defs/choice" } },
            "not": {
              "properties": {
                "failureCode": { "$ref": "#/$defs/id" }
              },
              "required": ["failureCode"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["rejected", "failed"] }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["failureCode"],
            "properties": { "choice": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "pending" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "choice": { "type": "null" } },
            "not": {
              "properties": {
                "failureCode": { "$ref": "#/$defs/id" }
              },
              "required": ["failureCode"]
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "decisionId",
        "decisionClass",
        "outcome",
        "consulted"
      ],
      "properties": {
        "documentId": { "$ref": "#/$defs/id" },
        "decisionId": { "$ref": "#/$defs/id" },
        "decisionClass": { "$ref": "#/$defs/id" },
        "outcome": {
          "enum": ["deterministic", "consulted", "review-required"]
        },
        "consulted": { "type": "boolean" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionCount", "consultationCount", "consultationRate"],
      "properties": {
        "decisionCount": { "type": "integer", "minimum": 0 },
        "consultationCount": { "type": "integer", "minimum": 0 },
        "consultationRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalDecisionCount",
        "totalConsultationCount",
        "consultationRate",
        "byDecisionClass"
      ],
      "properties": {
        "totalDecisionCount": { "type": "integer", "minimum": 0 },
        "totalConsultationCount": { "type": "integer", "minimum": 0 },
        "consultationRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "byDecisionClass": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metric" }
        }
      }
    }
  }
}
