{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ernie.sg/schemas/pdf-corpus-audit-1.10.0.json",
  "title": "Local PDF corpus audit report with citation candidate and evidence binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportSchema",
    "privacy",
    "executionProvenance",
    "policy",
    "summary",
    "documents"
  ],
  "properties": {
    "schemaVersion": { "const": "1.10.0" },
    "reportSchema": {
      "const": "docs/schemas/pdf-corpus-audit-v1.10.schema.json"
    },
    "privacy": { "const": "basenames-hashes-metrics-diagnostics-only" },
    "executionProvenance": {
      "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.7.0.json#/$defs/executionProvenance"
    },
    "policy": {
      "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/policy"
    },
    "corpusContract": {
      "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/corpusContractBinding"
    },
    "summary": {
      "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.9.0.json#/properties/summary"
    },
    "documents": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/auditedDocument" },
          {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/failedDocument"
          }
        ]
      }
    }
  },
  "$defs": {
    "citationRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "taxonomy",
        "referenceRegionId",
        "referenceStart",
        "referenceEnd",
        "labels",
        "targetNodeIds",
        "candidateNodeIds",
        "canonicalAnchor",
        "evidenceSha256s",
        "sourceBoxes"
      ],
      "properties": {
        "id": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "status": { "enum": ["matched", "ambiguous", "unresolved"] },
        "taxonomy": {
          "enum": [
            "bracketed-bibliography-citation",
            "author-year-bibliography-citation",
            "superscript-citation-cluster",
            "superscript-bibliography-citation",
            "human-reclassified-citation"
          ]
        },
        "referenceRegionId": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "referenceStart": { "type": "integer", "minimum": 0 },
        "referenceEnd": { "type": "integer", "minimum": 1 },
        "labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
          }
        },
        "targetNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
          }
        },
        "candidateNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
          }
        },
        "canonicalAnchor": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodeId", "start", "end"],
              "properties": {
                "nodeId": {
                  "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
                },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "evidenceSha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
          }
        },
        "sourceBoxes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sourceBox"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "matched" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "targetNodeIds": { "minItems": 1 },
              "candidateNodeIds": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "ambiguous" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "targetNodeIds": { "maxItems": 0 },
              "candidateNodeIds": { "minItems": 2 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "unresolved" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "targetNodeIds": { "maxItems": 0 } }
          }
        }
      ]
    },
    "structuralReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "canonicalNodeCount",
        "canonicalNodeSequenceSha256",
        "canonicalNodeTypeSequenceSha256",
        "canonicalContentSha256",
        "canonicalNodeProvenanceSha256",
        "readingOrderGraphSha256",
        "nodeCounts",
        "visualRelationshipCount",
        "visualRelationshipCounts",
        "visualRelationshipGraphSha256",
        "noteRelationshipCount",
        "noteRelationshipCounts",
        "noteRelationshipGraphSha256",
        "citationRelationshipCount",
        "citationRelationshipCounts",
        "citationRelationshipGraph",
        "citationRelationshipGraphSha256",
        "crossReferenceRelationshipCount",
        "crossReferenceRelationshipCounts",
        "crossReferenceRelationshipGraph",
        "crossReferenceRelationshipGraphSha256",
        "assetCount",
        "assetCounts",
        "assetManifestSha256",
        "lineTransitionLedgerAvailable",
        "lineTransitionCount",
        "lineTransitionLedgerSha256",
        "unresolvedCorruptingJoinCount",
        "structurallyConsumedLineBoundaryCount",
        "canonicalHyphenDeletionLedgerAvailable",
        "canonicalHyphenDeletionCount",
        "canonicalHyphenDeletionContextCounts",
        "canonicalHyphenDeletionLedger",
        "canonicalHyphenDeletionLedgerSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "1.7.0" },
        "canonicalNodeCount": { "type": "integer", "minimum": 0 },
        "canonicalNodeSequenceSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "canonicalNodeTypeSequenceSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "canonicalContentSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "canonicalNodeProvenanceSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "readingOrderGraphSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "nodeCounts": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/countMap"
        },
        "visualRelationshipCount": { "type": "integer", "minimum": 0 },
        "visualRelationshipCounts": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/countMap"
        },
        "visualRelationshipGraphSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "noteRelationshipCount": { "type": "integer", "minimum": 0 },
        "noteRelationshipCounts": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/countMap"
        },
        "noteRelationshipGraphSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "citationRelationshipCount": { "type": "integer", "minimum": 0 },
        "citationRelationshipCounts": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/countMap"
        },
        "citationRelationshipGraph": {
          "type": "array",
          "items": { "$ref": "#/$defs/citationRelationship" }
        },
        "citationRelationshipGraphSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "crossReferenceRelationshipCount": {
          "type": "integer",
          "minimum": 0
        },
        "crossReferenceRelationshipCounts": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/countMap"
        },
        "crossReferenceRelationshipGraph": {
          "type": "array",
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/crossReferenceRelationship"
          }
        },
        "crossReferenceRelationshipGraphSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "assetCount": { "type": "integer", "minimum": 0 },
        "assetCounts": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/countMap"
        },
        "assetManifestSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "lineTransitionLedgerAvailable": { "type": "boolean" },
        "lineTransitionCount": { "type": "integer", "minimum": 0 },
        "lineTransitionLedgerSha256": {
          "oneOf": [
            {
              "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
            },
            { "type": "null" }
          ]
        },
        "unresolvedCorruptingJoinCount": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "structurallyConsumedLineBoundaryCount": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "canonicalHyphenDeletionLedgerAvailable": { "const": true },
        "canonicalHyphenDeletionCount": {
          "type": "integer",
          "minimum": 0
        },
        "canonicalHyphenDeletionContextCounts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bibliography-continuation": {
              "type": "integer",
              "minimum": 1
            },
            "canonical-flow-continuation": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "canonicalHyphenDeletionLedger": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.9.0.json#/$defs/canonicalHyphenDeletionRecord"
          }
        },
        "canonicalHyphenDeletionLedgerSha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lineTransitionLedgerAvailable": { "const": true }
            },
            "required": ["lineTransitionLedgerAvailable"]
          },
          "then": {
            "properties": {
              "lineTransitionLedgerSha256": {
                "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
              },
              "unresolvedCorruptingJoinCount": {
                "type": "integer",
                "minimum": 0
              },
              "structurallyConsumedLineBoundaryCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "lineTransitionCount": { "const": 0 },
              "lineTransitionLedgerSha256": { "type": "null" },
              "unresolvedCorruptingJoinCount": { "type": "null" },
              "structurallyConsumedLineBoundaryCount": { "type": "null" }
            }
          }
        }
      ]
    },
    "auditedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basename",
        "sha256",
        "byteLength",
        "pageCount",
        "completeness",
        "readiness",
        "structure",
        "diagnosticCounts",
        "diagnosticSampleLimit",
        "diagnosticSamplesTruncated",
        "diagnostics"
      ],
      "properties": {
        "basename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "sha256": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/sha256"
        },
        "byteLength": { "type": "integer", "minimum": 0 },
        "pageCount": { "type": "integer", "minimum": 1 },
        "completeness": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/completeness"
        },
        "readiness": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/readiness"
        },
        "structure": { "$ref": "#/$defs/structuralReceipt" },
        "ocr": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.6.0.json#/$defs/ocrPageProvenance"
          }
        },
        "diagnosticCounts": {
          "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/countMap"
        },
        "diagnosticSampleLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "perCode"],
          "properties": {
            "total": { "const": 64 },
            "perCode": { "const": 3 }
          }
        },
        "diagnosticSamplesTruncated": { "type": "integer", "minimum": 0 },
        "diagnostics": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/diagnostic"
          }
        },
        "exports": {
          "type": "array",
          "items": {
            "$ref": "https://ernie.sg/schemas/pdf-corpus-audit-1.5.0.json#/$defs/export"
          }
        }
      }
    }
  }
}
