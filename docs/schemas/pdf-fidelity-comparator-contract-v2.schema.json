{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ernie.sg/schemas/pdf-fidelity-comparator-contract-v2-1.0.0.json",
  "title": "Versioned governance contract for fidelity comparator sidecars",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "privacy",
    "receiptSchema",
    "runSpecificationSchemaVersion",
    "evaluationBindings",
    "authority"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "privacy": {
      "const": "public-identities-hashes-governance-no-source-content-or-local-paths"
    },
    "receiptSchema": { "$ref": "#/$defs/fileBinding" },
    "runSpecificationSchemaVersion": { "const": "2.0.0" },
    "evaluationBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "governance", "evalSet"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "governance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "schemaVersion", "path", "fileSha256"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "schemaVersion": { "enum": ["1.0.0", "2.0.0"] },
              "path": { "$ref": "#/$defs/path" },
              "fileSha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "evalSet": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "fileSha256",
              "evalSetSha256",
              "documentIdentitySha256",
              "caseIdentitySha256",
              "documentCount",
              "caseCount",
              "stratumCount"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "path": { "$ref": "#/$defs/path" },
              "fileSha256": { "$ref": "#/$defs/sha256" },
              "evalSetSha256": { "$ref": "#/$defs/sha256" },
              "documentIdentitySha256": { "$ref": "#/$defs/sha256" },
              "caseIdentitySha256": { "$ref": "#/$defs/sha256" },
              "documentCount": { "type": "integer", "minimum": 1 },
              "caseCount": { "type": "integer", "minimum": 1 },
              "stratumCount": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "authority": {
      "const": "performance-provenance-sidecar-never-promotion-authority"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(benchmarks|docs)/[A-Za-z0-9._/+:-]+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "fileSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
