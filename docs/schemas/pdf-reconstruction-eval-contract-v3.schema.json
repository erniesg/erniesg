{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ernie.sg/schemas/pdf-reconstruction-eval-contract-3.0.0.json",
  "title": "Additive disjoint-corpus governance contract for scholarly PDF reconstruction evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "privacy",
    "extends",
    "robustnessCorpus",
    "authority",
    "taxonomySaturation"
  ],
  "properties": {
    "schemaVersion": { "const": "3.0.0" },
    "id": {
      "const": "scholarly-pdf-reconstruction-eval-governance-2026-07-v3"
    },
    "privacy": {
      "const": "public-identities-hashes-governance-metadata-no-source-content-or-local-paths"
    },
    "extends": { "$ref": "#/$defs/baseContract" },
    "robustnessCorpus": { "$ref": "#/$defs/robustnessCorpus" },
    "authority": { "$ref": "#/$defs/authority" },
    "taxonomySaturation": { "$ref": "#/$defs/taxonomySaturation" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,191}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileSha256"],
      "properties": {
        "path": {
          "const": "benchmarks/pdf/corpus-contract-v2.json"
        },
        "fileSha256": {
          "const": "91b38615b1f9b4acce960bc6ee23d41a8c7eb048714184a469677af0645bc956"
        }
      }
    },
    "baseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "fileSha256"],
      "properties": {
        "id": {
          "const": "scholarly-pdf-reconstruction-eval-governance-2026-07-v2"
        },
        "path": {
          "const": "benchmarks/pdf/reconstruction-eval-contract-v2.json"
        },
        "fileSha256": {
          "const": "4e971f847e6088ee56dd0d0b1688e1fdf73dc3d173b77892dec94e0ac07e3844"
        }
      }
    },
    "corpusSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "documentCount", "documentIdentitySha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "documentCount": { "const": 10 },
        "documentIdentitySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "robustnessCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "canonicalContractSha256",
        "frozenSet",
        "seededRandomSet",
        "selectionPolicy",
        "runCount",
        "distinctDocumentCount",
        "overlapDocumentIds"
      ],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "canonicalContractSha256": {
          "const": "df8d26b2dfa64e2afe106d4ac53b630012918aeba4638b437307748ee3541814"
        },
        "frozenSet": {
          "allOf": [
            { "$ref": "#/$defs/corpusSet" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "frozen-10-2026-07-20-v1" },
                "documentIdentitySha256": {
                  "const": "4486bb696a8b7b9b2cc853f20510c6c006b4fdfab2883ec9d593b27c17192f67"
                }
              }
            }
          ]
        },
        "seededRandomSet": {
          "allOf": [
            { "$ref": "#/$defs/corpusSet" },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "seeded-random-disjoint-10-2026-07-25-v2"
                },
                "documentIdentitySha256": {
                  "const": "2c6c49ecf9bd4b6f48a22eeb477bcde254ca3064f0359165da4f0c482a99ebe8"
                }
              }
            }
          ]
        },
        "selectionPolicy": {
          "const": "sha256-rank-without-replacement-excluding-frozen-v1"
        },
        "runCount": { "const": 20 },
        "distinctDocumentCount": { "const": 20 },
        "overlapDocumentIds": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "promotionAuthority"],
      "properties": {
        "role": {
          "const": "whole-paper-discovery-and-regression-not-labelled-holdout"
        },
        "promotionAuthority": {
          "const": "none-objective-gates-and-independent-blind-evidence-remain-required"
        }
      }
    },
    "taxonomySaturation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "labeledBoundedTraceCount",
        "targetApproximateTraceCount",
        "requiredFinalNoNewClassWindow",
        "observedFinalNoNewClassWindow",
        "robustnessRunCount",
        "distinctRobustnessDocumentCount"
      ],
      "properties": {
        "status": { "const": "not-saturated" },
        "labeledBoundedTraceCount": { "const": 32 },
        "targetApproximateTraceCount": { "const": 100 },
        "requiredFinalNoNewClassWindow": { "const": 20 },
        "observedFinalNoNewClassWindow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        },
        "robustnessRunCount": { "const": 20 },
        "distinctRobustnessDocumentCount": { "const": 20 }
      }
    }
  }
}
