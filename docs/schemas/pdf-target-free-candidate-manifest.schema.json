{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ernie.sg/schemas/pdf-target-free-candidate-manifest-1.0.0.json",
  "title": "Target-free scholarly PDF candidate acquisition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "privacy", "documents"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "privacy": {
      "const": "public-document-identities-only-no-source-content-layout-targets-or-gold"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "byteLength", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
