# Repo-owned pulse wrapper. It intentionally does not use the
# rucksack-autopilot-*-drain name so Rucksack's containment pass can hold the
# candidate drain without disabling the durable overnight scheduler.
[Unit]
Description=Resilient STRUCT queue pulse for erniesg/erniesg
Documentation=man:systemd.service(5)
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.config/rucksack/overnight/erniesg-erniesg.enabled
ConditionPathExists=!%h/.config/rucksack/overnight/erniesg-erniesg.hold

[Service]
Type=oneshot
TimeoutStartSec=30min
TimeoutStopSec=5min
ExecStart=/bin/sh -eu -c 'target=rucksack-autopilot-v1-ZXJuaWVzZy9lcm5pZXNn-drain.service; hold=%h/.config/rucksack/overnight/erniesg-erniesg.hold; session_marker=rucksack-erniesg-erniesg-issue; session_marker=${session_marker}-; if [ -e "$hold" ]; then exit 0; fi; state=$(systemctl --user show "$target" -p ActiveState --value 2>/dev/null || true); case "$state" in active|activating) exit 0 ;; esac; if pgrep -af "tmux -L" 2>/dev/null | grep -F -- "$session_marker" >/dev/null; then exit 0; fi; load=$(systemctl --user show "$target" -p LoadState --value 2>/dev/null || true); case "$load" in masked) systemctl --user unmask "$target"; systemctl --user daemon-reload ;; loaded) ;; *) exit 0 ;; esac; systemctl --user start --wait "$target"'
