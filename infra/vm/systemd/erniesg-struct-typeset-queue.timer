# Durable scheduler for the STRUCT queue. Rucksack containment only matches
# its generated drain names; this pulse therefore survives a worker handoff
# and can re-enter the proven drain service on the next bounded pass.
[Unit]
Description=STRUCT queue pulse every 30 minutes
Documentation=man:systemd.timer(5)

[Timer]
OnBootSec=5m
OnUnitActiveSec=30m
Persistent=true
RandomizedDelaySec=5m
Unit=erniesg-struct-typeset-queue.service

[Install]
WantedBy=timers.target
