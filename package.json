{
  "name": "astro-erudite",
  "type": "module",
  "version": "1.2.4",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "postinstall": "npm run struct:build && node tools/publication-install-browser.mjs",
    "struct:build": "npm --prefix packages/struct run build",
    "dev": "astro dev",
    "start": "astro dev",
    "pretest": "npm run srt:checkpoint-evidence && npm run srt:overlay-evidence",
    "test": "vitest run --exclude 'tests/e2e/**' --maxWorkers=1 && npm run pdf:association-audit:test",
    "test:e2e": "playwright test",
    "build": "npm run build:production",
    "build:astro": "astro check && astro build",
    "build:production": "PUBLIC_RESEARCH_RELEASE=production npm run build:astro && PUBLIC_RESEARCH_RELEASE=production node tools/deployment/apply-release-gate.mjs && npm run publication:build -- --adapter astro --entry moving-to-cloudflare-with-astro --output .agent/evidence/publication && npm run publication:check -- --input .agent/evidence/publication --matrix phone-webpub,eink-epub,a5-pdf,a4-pdf",
    "build:staging": "PUBLIC_RESEARCH_RELEASE=staging npm run build:astro",
    "srt:export": "PUBLIC_RESEARCH_RELEASE=staging astro check && PUBLIC_RESEARCH_RELEASE=staging astro build --outDir .agent/evidence/srt-export",
    "srt:checkpoint-evidence": "playwright install chromium && node tools/srt-source-output-evidence.mjs",
    "preview": "astro preview",
    "srt:evaluate": "node tools/srt/demo-evaluation.mjs",
    "pdf:corpus-audit": "node tools/pdf-corpus-audit.mjs",
    "pdf:corpus-regenerate": "node tools/pdf-corpus-orchestrator.mjs",
    "pdf:corpus-regenerate:test": "node --test --test-concurrency=1 tools/pdf-corpus-orchestrator.node-test.mjs tools/pdf-corpus-orchestrator-determinism.node-test.mjs",
    "pdf:association-audit:test": "node --test --test-concurrency=1 tools/pdf-association-fixture-audit.node-test.mjs",
    "pdf:export": "node tools/pdf-export.mjs",
    "pdf:local:doctor": "node tools/pdf-local-mac-doctor.mjs",
    "pdf:benchmark:compare": "node tools/pdf-benchmark-compare.mjs",
    "pdf:benchmark:extraction": "node tools/pdf-extraction-eval.mjs",
    "pdf:ocr:benchmark": "node tools/pdf-ocr-engine-benchmark.mjs",
    "pdf:benchmark:readiness": "node tools/pdf-benchmark-readiness.mjs",
    "pdf:extraction:bakeoff": "node --experimental-strip-types tools/pdf-extraction-bakeoff.mjs --self-test --score-ledger .agent/evidence/pdf-extraction-bakeoff-score-ledger.json",
    "pdf:private-decisions:compose": "node tools/pdf-private-decision-compose.mjs",
    "pdf:private-fidelity": "node tools/pdf-private-fidelity.mjs",
    "pdf:review-sink": "node tools/pdf-review-langfuse-bridge.mjs",
    "pdf:eval": "node tools/pdf-fidelity-eval.mjs score",
    "pdf:eval:compare": "node tools/pdf-fidelity-eval.mjs compare",
    "pdf:eval:comparator": "node tools/pdf-fidelity-comparator-run.mjs",
    "pdf:eval:local": "node tools/pdf-fidelity-eval.mjs local",
    "pdf:eval:suite": "node tools/pdf-fidelity-suite.mjs build",
    "pdf:eval:mineru-adapter": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/pdf-fidelity-mineru-adapter.mjs",
    "pdf:eval:target-free": "node tools/pdf-target-free-candidate-run.mjs",
    "pdf:eval:target-free-predictions": "node tools/pdf-target-free-predictions.mjs",
    "publication:build": "tsx tools/publication-build.mjs",
    "publication:check": "tsx tools/publication-check.mjs",
    "srt:overlay-evidence": "node tools/pdf-diagnostic-evidence.mjs",
    "worker:build": "npm run build:production",
    "worker:deploy:preview": "npm run build:staging && wrangler deploy --config wrangler.jsonc --message \"Deploy ernie.sg Workers preview\"",
    "worker:deploy:production": "npm run build:production && wrangler deploy --config wrangler.production.jsonc --message \"Deploy ernie.sg Workers production\"",
    "worker:rollback:dry-run": "wrangler delete erniesg-workers --config wrangler.production.jsonc --dry-run",
    "worker:rollback": "wrangler delete erniesg-workers --config wrangler.production.jsonc --force",
    "worker:verify": "node tools/deployment/verify-cloudflare.mjs",
    "astro": "astro",
    "prettier": "prettier --write .",
    "translate:audit": "node tools/translation/audit.mjs",
    "translate:classify": "node tools/translation/classify.mjs",
    "translate:reconcile-legacy": "node tools/translation/reconcile-legacy.mjs",
    "translate:style-corpus": "node tools/translation/style-corpus.mjs",
    "translate:research": "node tools/translation/research.mjs",
    "translate:check": "node tools/translation/check-quality.mjs",
    "translate:generate": "node tools/translation/generate.mjs",
    "translate:sync": "node tools/translation/sync.mjs",
    "translate:codex-sync": "TRANSLATION_PROVIDER=codex-cli CODEX_TRANSLATION_MODEL=gpt-5.5 CODEX_TRANSLATION_REASONING_EFFORT=high node tools/translation/sync.mjs",
    "translate:codex-review": "TRANSLATION_PROVIDER=codex-cli CODEX_TRANSLATION_MODEL=gpt-5.5 CODEX_TRANSLATION_REASONING_EFFORT=high CODEX_TRANSLATION_REVIEW_CONCURRENCY=2 node tools/translation/check-quality.mjs --refresh-review",
    "translate:codex-revise": "TRANSLATION_PROVIDER=codex-cli CODEX_TRANSLATION_MODEL=gpt-5.5 CODEX_TRANSLATION_REASONING_EFFORT=high CODEX_TRANSLATION_REVISION_CONCURRENCY=2 node tools/translation/revise.mjs",
    "translate:repair": "node tools/translation/repair.mjs",
    "translate:mark-edited": "node tools/translation/mark-edited.mjs",
    "translate:finalize": "node tools/translation/finalize.mjs",
    "translate:test": "vitest run tools/translation/*.test.mjs",
    "i18n:check": "vitest run src/lib/i18n.test.ts",
    "content:check": "npm run translate:audit && npm run translate:check && npm run i18n:check && npm run build",
    "content:publish": "npm run translate:codex-sync -- --write && npm run translate:codex-review && npm run translate:codex-revise -- --write && npm run translate:codex-review && npm run translate:codex-revise -- --write && npm run translate:codex-review -- --strict-publish && npm run i18n:check && npm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@erniesg/struct": "file:packages/struct",
    "@hbsnow/rehype-sectionize": "^1.0.7",
    "@iconify-json/lucide": "^1.2.20",
    "@mdx-js/mdx": "3.1.1",
    "@napi-rs/canvas": "0.1.100",
    "@puppeteer/browsers": "3.0.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@rehype-pretty/transformers": "^0.13.2",
    "@shikijs/transformers": "^1.24.4",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vivliostyle/cli": "11.1.0",
    "astro": "^7.1.3",
    "astro-icon": "^1.1.4",
    "bootstrap-icons": "^1.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "epubcheck-static": "4.0.0-v5.3.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "0.8.3",
    "jszip": "3.10.1",
    "lucide-react": "^0.469.0",
    "parse5": "^8.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "playwright": "1.61.1",
    "puppeteer-core": "25.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.0",
    "remark-emoji": "^5.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-toc": "^9.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "tsx": "4.23.1",
    "typescript": "^5.7.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.5.2",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "openai": "^6.45.0",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-astro-organize-imports": "^0.4.11",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "astro-icon": {
      "@iconify/tools": "5.0.12"
    },
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "prismjs": "1.30.0",
    "sharp": "0.35.3",
    "trim": "0.0.3",
    "undici@>=7.0.0 <7.29.0": "7.29.0",
    "uuid": "11.1.1",
    "valibot": "1.4.2",
    "@iconify/tools": "5.0.12"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
