{
  "name": "astro-erudite",
  "type": "module",
  "version": "1.2.4",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "build": "astro check && astro build && node tools/deployment/research-release-gate.mjs",
    "research:build": "PUBLIC_RESEARCH_ENABLED=true npm run build",
    "preview": "astro preview",
    "worker:build": "npm run build",
    "worker:deploy:preview": "PUBLIC_RESEARCH_ENABLED=true npm run worker:build && wrangler deploy --config wrangler.jsonc --message \"Deploy staged ernie.sg research preview\"",
    "worker:deploy:production": "npm run worker:build && wrangler deploy --config wrangler.production.jsonc --message \"Deploy ernie.sg Workers production\"",
    "worker:rollback:dry-run": "wrangler delete erniesg-workers --config wrangler.production.jsonc --dry-run",
    "worker:rollback": "wrangler delete erniesg-workers --config wrangler.production.jsonc --force",
    "worker:verify": "node tools/deployment/verify-cloudflare.mjs",
    "astro": "astro",
    "prettier": "prettier --write .",
    "translate:audit": "node tools/translation/audit.mjs",
    "translate:classify": "node tools/translation/classify.mjs",
    "translate:reconcile-legacy": "node tools/translation/reconcile-legacy.mjs",
    "translate:style-corpus": "node tools/translation/style-corpus.mjs",
    "translate:research": "node tools/translation/research.mjs",
    "translate:check": "node tools/translation/check-quality.mjs",
    "translate:generate": "node tools/translation/generate.mjs",
    "translate:sync": "node tools/translation/sync.mjs",
    "translate:codex-sync": "TRANSLATION_PROVIDER=codex-cli CODEX_TRANSLATION_MODEL=gpt-5.5 CODEX_TRANSLATION_REASONING_EFFORT=high node tools/translation/sync.mjs",
    "translate:codex-review": "TRANSLATION_PROVIDER=codex-cli CODEX_TRANSLATION_MODEL=gpt-5.5 CODEX_TRANSLATION_REASONING_EFFORT=high CODEX_TRANSLATION_REVIEW_CONCURRENCY=2 node tools/translation/check-quality.mjs --refresh-review",
    "translate:codex-revise": "TRANSLATION_PROVIDER=codex-cli CODEX_TRANSLATION_MODEL=gpt-5.5 CODEX_TRANSLATION_REASONING_EFFORT=high CODEX_TRANSLATION_REVISION_CONCURRENCY=2 node tools/translation/revise.mjs",
    "translate:repair": "node tools/translation/repair.mjs",
    "translate:mark-edited": "node tools/translation/mark-edited.mjs",
    "translate:finalize": "node tools/translation/finalize.mjs",
    "translate:test": "vitest run tools/translation/*.test.mjs",
    "i18n:check": "vitest run src/lib/i18n.test.ts",
    "content:check": "npm run translate:audit && npm run translate:check && npm run i18n:check && npm run build",
    "content:publish": "npm run translate:codex-sync -- --write && npm run translate:codex-review && npm run translate:codex-revise -- --write && npm run translate:codex-review && npm run translate:codex-revise -- --write && npm run translate:codex-review -- --strict-publish && npm run i18n:check && npm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^6.0.1",
    "@astrojs/mdx": "^4.0.3",
    "@astrojs/react": "^4.1.2",
    "@astrojs/rss": "^4.0.10",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "@hbsnow/rehype-sectionize": "^1.0.7",
    "@iconify-json/lucide": "^1.2.20",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@rehype-pretty/transformers": "^0.13.2",
    "@shikijs/transformers": "^1.24.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "astro": "^5.1.1",
    "astro-icon": "^1.1.4",
    "bootstrap-icons": "^1.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.0",
    "remark-emoji": "^5.0.1",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "^0.5.15",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "openai": "^6.45.0",
    "parse5": "^8.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-astro-organize-imports": "^0.4.11",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^2.1.9",
    "wrangler": "4.110.0",
    "yaml": "^2.9.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
