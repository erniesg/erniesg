#!/usr/bin/env sh
node - "$@" <<'NODE'
const { mkdirSync, writeFileSync, existsSync, readFileSync, statSync } = require("node:fs");
const { join } = require("node:path");
const { spawnSync } = require("node:child_process");
const { createHash } = require("node:crypto");
const { validAssociationAudit } = require("./tools/association-audit-receipt.cjs");
const { validModelConsultationEvidence } = require("./tools/model-consultation-evidence-receipt.cjs");

const allLanes = [
  {
    "id": "association-audit",
    "command": "node tools/pdf-association-fixture-audit.mjs",
    "required": true
  },
  {
    "id": "unit",
    "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/model-consultation-evidence.ts",
    "required": true
  },
  {
    "id": "build",
    "command": "npm run build",
    "required": true
  },
  {
    "id": "test",
    "command": "npm run test",
    "required": true
  },
  {
    "id": "e2e",
    "command": "npm run test:e2e",
    "required": false
  }
];
// The hosted manifest schema uses the generic `unit` lane id. Keep the public,
// task-specific selector while emitting that compatibility id in the receipt.
const laneAliases = new Map([["model-consultation", "unit"]]);
const invocation = {
  argv: process.argv.slice(2),
  npm_config_e2e: process.env.npm_config_e2e || "",
  npm_config_only: process.env.npm_config_only || "",
};
const stamp = new Date().toISOString().replace(/[-:]/g, "").replace(".", "");
const outDir = join(".agent", "evidence", stamp);
mkdirSync(join(outDir, "logs"), { recursive: true });

// 900_000 was a coin flip on the trusted VM: the unit suite measures 869-923 s
// there against a 900 s ceiling, so the lane was killed mid-run and recorded a
// failure that said nothing about the branch.
//
// This is ONE budget shared by every lane, not a per-lane grant. Handing each
// sequential lane the full amount would let four hung lanes total 7_200_000 ms
// and blow the 5400 s supervision bound on the agent run, and because the
// manifest is written only after the loop, the supervisor would kill the
// worker without recording which lane hung.
const TOTAL_BUDGET_MS = 1_800_000;
const LANE_TIMEOUT_EXIT = 124;
// The setup probes below (HEAD, remote, branch, dirty) run before the lane
// budget exists. They must not inherit it: three stalled Git probes would
// otherwise burn the whole supervisor allowance before any lane runs or any
// manifest is written.
const SETUP_PROBE_TIMEOUT_MS = 60_000;

function sh(command, timeoutMs = SETUP_PROBE_TIMEOUT_MS) {
  return spawnSync(command, { shell: true, encoding: "utf8", timeout: timeoutMs });
}

function timedOut(proc) {
  // Node kills a timed-out child itself: error.code ETIMEDOUT, signal SIGTERM.
  // The trusted runner's wrapper instead catches TimeoutExpired and returns an
  // ordinary result with status 124 and neither field, so a predicate that
  // checks only the Node shape never fires under revalidation.
  // Deliberately NOT a bare `signal === "SIGTERM"` check: Node also terminates
  // a child with SIGTERM when its output exceeds maxBuffer, reporting
  // error.code ENOBUFS. Treating that as a timeout would rewrite an
  // output-heavy failure to 124 and skip every later lane with the budget
  // almost untouched.
  return (
    Boolean(proc.error && proc.error.code === "ETIMEDOUT")
    || proc.status === LANE_TIMEOUT_EXIT
  );
}

function safeRepository(value) {
  const candidate = String(value || "").trim().replace(/\.git$/, "");
  return /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(candidate) ? candidate : "";
}

function repositoryFromRemote(value) {
  const match = String(value || "").trim().match(/github\.com[/:]([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+)(?:\.git)?$/);
  return match ? safeRepository(match[1]) : "";
}

function safeBranch(value) {
  const candidate = String(value || "").trim();
  return candidate && candidate.length <= 255 && !/[\u0000-\u001f\u007f]/.test(candidate) ? candidate : "";
}

function textHash(value) {
  return createHash("sha256").update(value).digest("hex");
}

function splitList(value) {
  return value
    .split(",")
    .map((item) => item.trim())
    .filter(Boolean);
}

function parseSelection(argv) {
  let includeAll = false;
  let includeE2e = ["1", "true", "yes"].includes(String(process.env.npm_config_e2e || "").toLowerCase());
  const requestedOnly = [];
  const unknownArgs = [];
  const npmOnly = process.env.npm_config_only || "";
  if (npmOnly) requestedOnly.push(...splitList(npmOnly));

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--all") {
      includeAll = true;
    } else if (arg === "--e2e") {
      includeE2e = true;
    } else if (arg === "--only") {
      index += 1;
      if (index >= argv.length) unknownArgs.push("--only=<missing>");
      else requestedOnly.push(...splitList(argv[index]));
    } else if (arg.startsWith("--only=")) {
      requestedOnly.push(...splitList(arg.slice("--only=".length)));
    } else {
      unknownArgs.push(arg);
    }
  }

  const requestsModelConsultation = requestedOnly.includes("model-consultation");
  for (let index = 0; index < requestedOnly.length; index += 1) {
    requestedOnly[index] = laneAliases.get(requestedOnly[index]) || requestedOnly[index];
  }
  if (requestsModelConsultation && !requestedOnly.includes("association-audit")) {
    requestedOnly.push("association-audit");
  }

  const known = new Set(allLanes.map((lane) => lane.id));
  const unknownLanes = requestedOnly.filter((lane) => !known.has(lane));
  if (unknownArgs.length || unknownLanes.length) {
    return { error: `unknown selection: ${[...unknownArgs, ...unknownLanes].join(", ")}` };
  }

  if (requestedOnly.length) {
    return { lanes: allLanes.filter((lane) => requestedOnly.includes(lane.id)) };
  }
  if (includeAll) return { lanes: allLanes };

  const selected = allLanes.filter((lane) => lane.required);
  if (includeE2e) {
    for (const lane of allLanes) {
      if (lane.id === "e2e" && !selected.some((selectedLane) => selectedLane.id === lane.id)) {
        selected.push(lane);
      }
    }
  }
  return { lanes: selected };
}

const secretEntries = Object.entries(process.env)
  .filter(([key, value]) => /(TOKEN|SECRET|KEY|PASSWORD|COOKIE|SESSION|AUTH|WEBHOOK|CREDENTIAL)/i.test(key) && value && value.length >= 8)
  .sort((a, b) => b[1].length - a[1].length);

function redact(value) {
  let redacted = value || "";
  for (const [key, secret] of secretEntries) {
    redacted = redacted.split(secret).join(`[REDACTED:${key}]`);
  }
  return redacted;
}

function storagePolicy() {
  const storagePath = join(".agent", "storage.yaml");
  const defaultLimitMb = 10;
  if (!existsSync(storagePath)) return { repo_limit_mb: defaultLimitMb, source: "default storage policy" };
  const text = readFileSync(storagePath, "utf8");
  const match = text.match(/repo_limit_mb:\s*([0-9]+(?:\.[0-9]+)?)/);
  const parsed = match ? Number.parseFloat(match[1]) : defaultLimitMb;
  const repoLimitMb = Number.isFinite(parsed) && parsed > 0 ? parsed : defaultLimitMb;
  return { repo_limit_mb: repoLimitMb, source: storagePath };
}

function largeUntrackedEvidence() {
  const policy = storagePolicy();
  const limitBytes = Math.floor(policy.repo_limit_mb * 1024 * 1024);
  const artifacts = [];
  const caveats = [];
  const proc = spawnSync("git", ["ls-files", "--others", "--exclude-standard"], {
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
  });
  if (proc.status !== 0) {
    const reason = proc.error ? `${proc.error.name}: ${proc.error.message}` : `exit ${proc.status ?? 1}`;
    caveats.push(`large-file scan skipped: git ls-files failed with ${reason}`);
    return { artifacts, caveats };
  }

  for (const rawPath of (proc.stdout || "").split(/\r?\n/)) {
    const path = rawPath.trim();
    if (!path || path.startsWith(".agent/evidence/")) continue;
    let stats;
    try {
      stats = statSync(path);
    } catch (_error) {
      continue;
    }
    if (!stats.isFile() || stats.size <= limitBytes) continue;
    artifacts.push({
      kind: "large-untracked-file",
      path,
      size_bytes: stats.size,
      repo_limit_mb: policy.repo_limit_mb,
      storage: "object-storage-or-git-lfs",
    });
    caveats.push(
      `large untracked file ${path} (${stats.size} bytes) exceeds ${policy.source} repo_limit_mb ${policy.repo_limit_mb}; move it to object storage/Git LFS or ignore it before commit`
    );
  }
  return { artifacts, caveats };
}

function writeManifest(data, exitCode) {
  writeFileSync(join(outDir, "manifest.json"), `${JSON.stringify(data, null, 2)}\n`);
  console.log(`[agent-evidence] ${data.result}: ${join(outDir, "manifest.json")}`);
  process.exit(exitCode);
}

const gitCommit = process.env.GITHUB_HEAD_SHA || sh("git rev-parse --verify HEAD").stdout.trim() || "unknown";
const evidenceRepo = safeRepository(process.env.GITHUB_REPOSITORY)
  || repositoryFromRemote(sh("git config --get remote.origin.url").stdout)
  || "erniesg";
const gitBranch = safeBranch(process.env.GITHUB_HEAD_REF)
  || safeBranch(process.env.GITHUB_REF_NAME)
  || safeBranch(sh("git branch --show-current").stdout);
const dirtyProbe = sh("git status --short");
if (dirtyProbe.error || typeof dirtyProbe.status !== "number" || dirtyProbe.status !== 0) {
  // An empty stdout from a killed or failed probe is indistinguishable from a
  // clean tree. Fail closed rather than record an unestablished state as clean
  // and let a passing manifest through on it.
  const why = dirtyProbe.error ? `${dirtyProbe.error.code || dirtyProbe.error.name}` : `exit ${dirtyProbe.status}`;
  console.error(`[agent-evidence] cannot establish worktree cleanliness: git status ${why}`);
  process.exit(1);
}
const dirty = dirtyProbe.stdout.trim().length > 0;
const startedAt = new Date();
const results = [];
let associationAudit = null;
let modelConsultation = null;
const selection = parseSelection(invocation.argv);
const largeFiles = largeUntrackedEvidence();

if (selection.error || !selection.lanes || selection.lanes.length === 0) {
  const endedAt = new Date();
  writeManifest({
    schema_version: "1",
    run_id: `agent-evidence-${stamp}`,
    repo: evidenceRepo,
    branch: gitBranch,
    commit: gitCommit,
    dirty,
    started_at: startedAt.toISOString(),
    ended_at: endedAt.toISOString(),
    duration_ms: endedAt.getTime() - startedAt.getTime(),
    agent_version: textHash(JSON.stringify(allLanes)),
    invocation,
    lanes_run: [],
    runner: {
      provider: process.env.AGENT_PROVIDER || (process.env.GITHUB_ACTIONS ? "github-actions" : "local"),
      os: process.platform,
      node: process.version,
    },
    lanes: [],
    association_audit: null,
    artifacts: [{ kind: "manifest", path: join(outDir, "manifest.json") }, ...largeFiles.artifacts],
    caveats: largeFiles.caveats,
    result: "blocked",
    blocked_reason: selection.error || "no validation lanes selected",
    required_failures: [],
  }, 2);
}

const lanes = selection.lanes;

const budgetDeadline = Date.now() + TOTAL_BUDGET_MS;
const skipCaveats = [];
const requiredSkipped = [];
let budgetSpentBy = "";
let lastLaneId = "";

for (const lane of lanes) {
  const laneStart = Date.now();
  // A lane that was never invoked must not appear as an executed lane: that
  // would claim coverage the run does not have. It is recorded as a caveat and
  // left out of results and lanes_run.
  const remaining = budgetDeadline - Date.now();
  if (budgetSpentBy || remaining <= 0) {
    if (!budgetSpentBy) budgetSpentBy = lastLaneId || "setup";
    skipCaveats.push(
      `lane not run: ${lane.id}; the ${budgetSpentBy} lane consumed the shared ${TOTAL_BUDGET_MS} ms budget`,
    );
    // Skipped lanes stay out of results so the receipt claims no coverage for
    // them -- which means requiredFailures cannot see them, so a skipped
    // REQUIRED lane has to force the overall result on its own. Otherwise a
    // lane finishing just before the deadline leaves the rest unrun and the
    // manifest still reports "passed".
    if (lane.required) requiredSkipped.push(lane.id);
    continue;
  }
  lastLaneId = lane.id;
  const proc = sh(lane.command, remaining > 0 ? remaining : 1);
  let exitCode = proc.status ?? 1;
  if (timedOut(proc)) {
    exitCode = LANE_TIMEOUT_EXIT;
    budgetSpentBy = lane.id;
  }
  let output = redact(`${proc.stdout || ""}${proc.stderr || ""}`);
  if (budgetSpentBy === lane.id) {
    output += `\n[agent-evidence] lane timed out against the shared ${TOTAL_BUDGET_MS} ms budget\n`;
  }
  if (lane.id === "association-audit" && exitCode === 0) {
    try {
      const candidate = JSON.parse(proc.stdout || "");
      if (!validAssociationAudit(candidate)) {
        throw new Error("audit output failed manifest receipt validation");
      }
      associationAudit = candidate;
    } catch (error) {
      exitCode = 1;
      output += `\n[agent-evidence] invalid association audit receipt: ${redact(error.message)}\n`;
    }
  }
  if (lane.id === "unit" && exitCode === 0) {
    try {
      const candidate = JSON.parse(proc.stdout || "");
      if (!validModelConsultationEvidence(candidate)) {
        throw new Error("invalid receipt");
      }
      modelConsultation = candidate;
    } catch (_error) {
      exitCode = 1;
      output += "\n[agent-evidence] invalid model-consultation evidence receipt\n";
    }
  }
  const logPath = join(outDir, "logs", `${lane.id}.log`);
  writeFileSync(logPath, output);
  results.push({
    ...lane,
    status: exitCode === 0 ? "passed" : "failed",
    exit_code: exitCode,
    duration_ms: Date.now() - laneStart,
    log_path: logPath,
  });
}

// Skipped required lanes belong here even though they are deliberately absent
// from `results`: they are required lanes that did not pass, and the manifest
// validator rejects a failed result whose required_failures is empty
// (.github/workflows/agent-evidence.yml). Keeping them out of results and
// lanes_run is what stops the receipt claiming coverage; naming them here is
// what keeps the receipt valid.
const requiredFailures = [
  ...results.filter((lane) => lane.required && lane.exit_code !== 0).map((lane) => lane.id),
  ...requiredSkipped,
];
const endedAt = new Date();
const modelConsultationArtifact = modelConsultation
  ? [{
      kind: "model-consultation-evidence",
      path: results.find(({ id }) => id === "unit").log_path,
    }]
  : [];
const manifest = {
  schema_version: "1",
  run_id: `agent-evidence-${stamp}`,
  repo: evidenceRepo,
  branch: gitBranch,
  commit: gitCommit,
  dirty,
  started_at: startedAt.toISOString(),
  ended_at: endedAt.toISOString(),
  duration_ms: endedAt.getTime() - startedAt.getTime(),
  agent_version: textHash(JSON.stringify(allLanes)),
  invocation,
  lanes_run: results.map((lane) => lane.id),
  runner: {
    provider: process.env.AGENT_PROVIDER || (process.env.GITHUB_ACTIONS ? "github-actions" : "local"),
    os: process.platform,
    node: process.version,
  },
  lanes: results,
  association_audit: associationAudit,
  artifacts: [
    { kind: "manifest", path: join(outDir, "manifest.json") },
    ...modelConsultationArtifact,
    ...largeFiles.artifacts,
  ],
  caveats: [...largeFiles.caveats, ...skipCaveats],
  result: requiredFailures.length === 0 ? "passed" : "failed",
  required_failures: requiredFailures,
};

writeManifest(manifest, requiredFailures.length === 0 ? 0 : 1);
NODE
