---
import AvatarComponent from '@/components/ui/avatar'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import {
  SUPPORTED_LOCALES,
  getCanonicalPostId,
  getLocaleFromPostId,
  getPostLocalePath,
  getTagLabel,
  isLegacyChinesePostId,
} from '@/lib/i18n'
import { parseAuthors } from '@/lib/server-utils'
import { formatDate, readingTime } from '@/lib/utils'
import { Image } from 'astro:assets'
import { type CollectionEntry, getCollection } from 'astro:content'
import Link from './Link.astro'

type Props = {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props as {
  entry: CollectionEntry<'blog'>
}

const locale = getLocaleFromPostId(entry.id)
const canonicalId = getCanonicalPostId(entry.id)
const formattedDate = formatDate(entry.data.date, locale)
const readTime = readingTime(entry.body!, locale)
const authors = await parseAuthors(entry.data.authors ?? [], locale)
const allPosts = await getCollection(
  'blog',
  (post) => !post.data.draft && !isLegacyChinesePostId(post.id),
)
type CardLocalization = {
  url: string
  title: string
  description: string
  date: string
  readTime: string
  tags: string[]
  imageAlt: string
}

const localizedEntries: [string, CardLocalization][] =
  SUPPORTED_LOCALES.flatMap((postLocale) => {
    const localizedEntry = allPosts.find(
      (post) =>
        getCanonicalPostId(post.id) === canonicalId &&
        getLocaleFromPostId(post.id) === postLocale,
    )

    if (!localizedEntry) return []

    return [
      [
        postLocale,
        {
          url: getPostLocalePath(localizedEntry.id, postLocale),
          title: localizedEntry.data.title,
          description: localizedEntry.data.description,
          date: formatDate(localizedEntry.data.date, postLocale),
          readTime: readingTime(localizedEntry.body!, postLocale),
          tags:
            localizedEntry.data.tags?.map((tag) =>
              getTagLabel(tag, postLocale),
            ) ?? [],
          imageAlt: localizedEntry.data.title,
        },
      ],
    ]
  })

const cardLocalizations = JSON.stringify(Object.fromEntries(localizedEntries))
---

<div
  class="not-prose rounded-xl border p-4 transition-colors duration-300 ease-in-out hover:bg-secondary/50"
  data-i18n-card
  data-localizations={cardLocalizations}
>
  <div class="flex flex-col gap-4 sm:flex-row">
    {
      entry.data.image && (
        <div class="max-w-[200px] sm:flex-shrink-0">
          <Link href={`/${entry.collection}/${entry.id}`} data-i18n-card-link>
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              width={1200}
              height={630}
              class="object-cover"
              data-i18n-card-image
            />
          </Link>
        </div>
      )
    }
    <div class="flex-grow">
      <h3 class="mb-1 text-lg font-semibold">
        <Link href={`/${entry.collection}/${entry.id}`} data-i18n-card-link>
          <span data-i18n-card-title>{entry.data.title}</span>
        </Link>
      </h3>
      <p class="mb-2 text-sm text-muted-foreground" data-i18n-card-description>
        {entry.data.description}
      </p>
      <div
        class="mb-2 flex flex-wrap items-center gap-x-2 text-xs text-muted-foreground"
      >
        {
          authors.length > 0 && (
            <>
              {authors.map((author) => (
                <div class="flex items-center gap-x-1.5">
                  <AvatarComponent
                    client:load
                    src={author.avatar}
                    alt={author.name}
                    fallback={author.name[0]}
                    className="size-5 rounded-full"
                  />
                  <span data-i18n-key={`author.${author.id}.name`}>
                    {author.name}
                  </span>
                </div>
              ))}
              <Separator orientation="vertical" className="h-4" />
            </>
          )
        }
        <span data-i18n-card-date>{formattedDate}</span>
        <Separator orientation="vertical" className="h-4" />
        <span data-i18n-card-read-time>{readTime}</span>
      </div>
      {
        entry.data.tags && (
          <div class="flex flex-wrap gap-2" data-i18n-card-tags>
            {entry.data.tags.map((tag) => (
              <Badge variant="secondary">
                <span data-i18n-card-tag-label>{getTagLabel(tag, locale)}</span>
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
