---
import Container from '@/components/Container.astro'
import { Separator } from '@/components/ui/separator'
import { SOCIAL_LINKS } from '@/consts'
import { getStaticTranslation } from '@/lib/i18n'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'
---

<footer class="py-4">
  <Container class="max-w-screen-xl">
    <div
      class="flex flex-col items-center justify-center gap-y-3 lg:flex-row lg:justify-between lg:gap-x-6"
    >
      <div class="flex items-center gap-x-2">
        <span class="text-center text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()}
          <span data-i18n-key="footer.rights"
            >{getStaticTranslation('footer.rights', 'en')}</span
          >
        </span>
        <Separator orientation="vertical" className="h-4" />
        <p class="text-center text-sm text-muted-foreground">
          <span data-i18n-key="footer.madeWith"
            >{getStaticTranslation('footer.madeWith', 'en')}</span
          >
          <Link
            href="https://github.com/jktrn"
            class="text-foreground"
            external
            underline>enscribe</Link
          >
        </p>
      </div>
      <nav aria-label="More" class="flex gap-x-4 text-sm">
        <a href="/about" data-i18n-key="nav.about"
          >{getStaticTranslation('nav.about', 'en')}</a
        >
        <a href="/tags" data-i18n-key="nav.tags"
          >{getStaticTranslation('nav.tags', 'en')}</a
        >
      </nav>
      {/* One row at every width: the columns shrink on small phones instead of wrapping. */}
      <SocialIcons
        links={SOCIAL_LINKS}
        className="grid w-full max-w-[23.5rem] grid-cols-8 gap-1 sm:gap-2 lg:w-[23.5rem] lg:shrink-0 [&_a]:aspect-square [&_a]:h-auto [&_a]:w-full"
      />
    </div>
  </Container>
</footer>
