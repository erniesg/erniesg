---
import {
  ATLAS_DESTINATIONS,
  COUNTRIES_TOTAL,
  COUNTRIES_VISITED,
} from '@/data/atlas'
import { flagUrl } from '@/lib/atlas/geo'
import { getStaticTranslation } from '@/lib/i18n'

const t = (key: string) => getStaticTranslation(key, 'en')
const places = ATLAS_DESTINATIONS.filter((d) => !d.territory)
---

<a href="/atlas" class="atlas-teaser group" data-atlas-teaser>
  <div class="atlas-teaser-globe" aria-hidden="true">
    <canvas data-atlas-teaser-canvas></canvas>
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="text-lg font-semibold" data-i18n-key="atlas.title">
        {t('atlas.title')}
      </h3>
      <p class="shrink-0 text-right">
        <span class="atlas-teaser-count font-semibold tabular-nums">
          {COUNTRIES_VISITED}<span class="atlas-teaser-total"
            >/{COUNTRIES_TOTAL}</span
          >
        </span>
      </p>
    </div>
    <p class="mt-1 text-sm text-muted-foreground" data-i18n-key="atlas.teaser">
      {t('atlas.teaser')}
    </p>
    <ul class="mt-3 flex flex-wrap gap-1">
      {
        places.map((place) => (
          <li>
            <img
              class="atlas-teaser-flag"
              alt=""
              width="20"
              height="15"
              loading="lazy"
              src={flagUrl(place.name)}
            />
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm font-medium">
      <span
        class="underline-offset-4 group-hover:underline"
        data-i18n-key="atlas.open"
      >
        {t('atlas.open')}
      </span>
      <span aria-hidden="true"> →</span>
    </p>
  </div>
</a>

<style>
  .atlas-teaser {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
  }
  .atlas-teaser-globe {
    flex: none;
    width: 8rem;
    height: 8rem;
  }
  .atlas-teaser-globe canvas {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .atlas-teaser-count {
    font-size: 1.25rem;
    color: #078969;
  }
  :global(.dark) .atlas-teaser-count {
    color: #1fc79b;
  }
  .atlas-teaser-total {
    font-size: 0.6em;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
  }
  .atlas-teaser-flag {
    width: 1.25rem;
    height: 0.9375rem;
    border-radius: 2px;
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.12);
    object-fit: cover;
  }
  @media (max-width: 480px) {
    .atlas-teaser-globe {
      width: 5.5rem;
      height: 5.5rem;
    }
  }
</style>

<script>
  import type { Globe } from '@/lib/atlas/globe'

  let teardown: (() => void) | undefined

  function mount() {
    teardown?.()
    teardown = undefined
    const canvas = document.querySelector<HTMLCanvasElement>(
      '[data-atlas-teaser-canvas]',
    )
    if (!canvas) return
    let globe: Globe | undefined
    let disposed = false
    // About stays light: nothing of the globe loads until the teaser is nearly on screen.
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        observer.disconnect()
        // It sits at the top of About, so wait until the page itself has settled.
        const idle =
          window.requestIdleCallback ??
          ((run: () => void) => setTimeout(run, 400))
        idle(() => {
          if (disposed) return
          Promise.all([
            import('@/lib/atlas/globe'),
            import('@/lib/atlas/geo'),
            import('world-atlas/countries-50m.json'),
          ])
            .then(([{ createGlobe }, { buildAtlasFeatures }, world]) => {
              if (disposed) return
              const features = buildAtlasFeatures(
                world.default as unknown as Parameters<
                  typeof buildAtlasFeatures
                >[0],
              )
              globe = createGlobe({ canvas, features, passive: true })
            })
            .catch((error) => {
              // The flags and the link still carry the teaser without WebGL.
              console.error('Atlas teaser failed to start', error)
              canvas.hidden = true
            })
        })
      },
      { rootMargin: '200px' },
    )
    observer.observe(canvas)
    teardown = () => {
      disposed = true
      observer.disconnect()
      globe?.dispose()
    }
  }

  document.addEventListener('astro:page-load', mount)
  document.addEventListener('astro:before-swap', () => {
    teardown?.()
    teardown = undefined
  })
</script>
