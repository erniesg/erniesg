---
/**
 * The book's look switch, and the plain reader's top bar.
 *
 * Two looks share one server-rendered page. `site` is the reading shell inside
 * the personal site's header and footer; `plain` is the quiet reader that
 * `books/tools/preview.py` draws: a thin bar with a Contents button, the book's
 * title and where you are, a serif column on an off-white page, and no site
 * chrome. `Head.astro` sets `data-book-look` on <html> before first paint from
 * localStorage (`book-look`), so a remembered choice never flashes the other
 * look; this component draws the switch and restyles the page for `plain`.
 *
 * In `site` only the switch shows, right-aligned above the shell. In `plain`
 * the whole bar shows, and the switch lives in it, because the site header is
 * hidden there.
 */
import type { Book } from '@/lib/books'

type Props = {
  book: Book
  /** The node being read, for the "where you are" counter. */
  currentId?: string
  /**
   * The chapter progress indicator, as `render.py` writes it. With it the bar
   * stays in view in both looks: pinned under the site header in `site`, and
   * in the middle of the plain bar in `plain`.
   */
  progress?: string
}

const { book, currentId, progress } = Astro.props
const total = book.nodes.length
const index = currentId
  ? book.nodes.findIndex((node) => node.id === currentId)
  : -1
const place = index + 1
const through = total > 0 ? Math.round((place / total) * 100) : 0
// Solved challenges, as preview.py counts them: the page code fills the count
// in from the reader's progress (`[data-progress-solved]`).
const challenges = book.nodes
  .filter((node) => node.kind === 'challenge')
  .map((node) => node.id)
const printHref = `${book.path}print/${currentId ? `#print-${currentId}` : ''}`
---

<div class="book-bar" data-book-bar data-has-progress={progress ? '' : undefined}>
  <div class="book-bar-start book-bar-plain-only">
    <button
      type="button"
      class="book-bar-button"
      aria-expanded="false"
      aria-controls="reading-navigation"
      data-book-contents-toggle
    >
      Contents
    </button>
    <a class="book-bar-title" href={book.path}>{book.title}</a>
    <a class="book-bar-link" href={`${book.path}map/`} data-astro-reload>Map</a>
    <a class="book-bar-link" href={printHref} data-astro-reload>Print</a>
  </div>

  {progress && <div class="book-bar-middle" set:html={progress} />}

  <div class="book-bar-end">
    <button
      type="button"
      class="book-bar-button book-bar-edit book-bar-plain-only"
      data-book-edit
      aria-pressed="false"
      hidden
    >
      Edit
    </button>
    <div class="book-look" role="group" aria-label="Look" title="Look (p)">
      <span class="book-look-label" aria-hidden="true">Look</span>
      <button
        type="button"
        class="book-look-choice"
        data-book-look-choice="site"
        aria-keyshortcuts="p"
        aria-pressed="true">Site</button
      >
      <button
        type="button"
        class="book-look-choice"
        data-book-look-choice="plain"
        aria-keyshortcuts="p"
        aria-pressed="false">Plain</button
      >
    </div>
    <button
      type="button"
      class="book-bar-button book-bar-theme"
      data-book-theme-toggle
      aria-label="Switch to dark theme"
      title="Theme"
    >
      <span class="book-theme-icon" aria-hidden="true"></span>
    </button>
    <div
      class="book-bar-progress book-bar-plain-only"
      title={place > 0 ? `${place} of ${total} in this book` : `${total} in this book`}
    >
      <div class="book-bar-progress-bar" aria-hidden="true">
        <i style={`width:${through}%`}></i>
      </div>
      <span class="book-bar-progress-text">
        {place}/{total}
        {
          challenges.length > 0 && (
            <>
              {' · '}
              <span data-progress-solved data-challenge-ids={challenges.join(' ')}>
                0/{challenges.length} solved
              </span>
            </>
          )
        }
      </span>
    </div>
  </div>
</div>
<div class="book-scrim" data-book-scrim hidden></div>

<script>
  import {
    BOOK_LOOK_ATTRIBUTE,
    BOOK_LOOK_STORAGE_KEY,
    DEFAULT_BOOK_LOOK,
    isBookLook,
    type BookLook,
  } from '@/lib/book-look'
  import { THEME_CHANGE_EVENT, THEME_STORAGE_KEY } from '@/lib/site-preferences'
  import {
    installBookKeys,
    trackChapterProgress,
  } from '../../../books/tools/runtime/book-nav.mjs'

  const root = document.documentElement

  // `[`/`]`, `j`/`k` and `?`, once per session; they read the page at the key
  // press, so the client router's swaps need nothing more. The indicator's
  // observers are per page.
  installBookKeys(document)
  let stopProgress = trackChapterProgress(document)
  document.addEventListener('astro:page-load', () => {
    stopProgress()
    stopProgress = trackChapterProgress(document)
  })

  function currentLook(): BookLook {
    const value = root.getAttribute(BOOK_LOOK_ATTRIBUTE)
    return isBookLook(value) ? value : DEFAULT_BOOK_LOOK
  }

  function setDrawer(open: boolean) {
    if (open) root.setAttribute('data-book-drawer', 'open')
    else root.removeAttribute('data-book-drawer')
    for (const toggle of document.querySelectorAll(
      '[data-book-contents-toggle]',
    )) {
      toggle.setAttribute('aria-expanded', String(open))
    }
    const scrim = document.querySelector<HTMLElement>('[data-book-scrim]')
    if (scrim) scrim.hidden = !open
  }

  function syncControls() {
    const look = currentLook()
    for (const choice of document.querySelectorAll(
      '[data-book-look-choice]',
    )) {
      choice.setAttribute(
        'aria-pressed',
        String(choice.getAttribute('data-book-look-choice') === look),
      )
    }
    const dark = root.classList.contains('dark')
    for (const toggle of document.querySelectorAll(
      '[data-book-theme-toggle]',
    )) {
      toggle.setAttribute(
        'aria-label',
        dark ? 'Switch to light theme' : 'Switch to dark theme',
      )
    }
  }

  // In `plain` the margin is its small "Margin" button (the collapsed mode, as
  // on a blog post), and the column beside the text holds the chapter rail.
  // A surface that asked for a collapsed margin keeps it in both looks.
  function syncMargin() {
    const keep =
      document.querySelector<HTMLElement>('[data-reading-shell]')?.dataset
        .marginDefault === 'collapsed'
    const collapsed = keep || currentLook() === 'plain'
    for (const rail of document.querySelectorAll('margin-rail')) {
      if (rail.hasAttribute('collapsed') !== collapsed) {
        rail.toggleAttribute('collapsed', collapsed)
      }
    }
  }

  // Plain shows one quiet Edit button in its bar, which drives the page's own
  // edit toggle; the toolbar appears only while editing (see the styles).
  function syncEdit() {
    const mode = document.querySelector<HTMLElement>('[data-edit-mode]')
    const toggle = document.querySelector('[data-edit-toggle]')
    const available = Boolean(mode && !mode.hidden)
    const pressed = toggle?.getAttribute('aria-pressed') === 'true'
    for (const proxy of document.querySelectorAll<HTMLElement>(
      '[data-book-edit]',
    )) {
      proxy.hidden = !available
      proxy.setAttribute('aria-pressed', String(pressed))
    }
  }

  let editWatch: MutationObserver | null = null
  function watchEdit() {
    editWatch?.disconnect()
    const mode = document.querySelector('[data-edit-mode]')
    if (mode) {
      editWatch = new MutationObserver(syncEdit)
      editWatch.observe(mode, {
        attributes: true,
        subtree: true,
        attributeFilter: ['hidden', 'aria-pressed'],
      })
    }
    syncEdit()
  }

  // "In this chapter": the section being read is marked, as on the preview.
  let stopRail = () => {}
  function trackRail() {
    stopRail()
    const links = [
      ...document.querySelectorAll<HTMLElement>('[data-rail-section]'),
    ]
    const headings = links
      .map((link) => document.getElementById(link.dataset.railSection ?? ''))
      .filter((heading): heading is HTMLElement => Boolean(heading))
    if (!headings.length) return
    let frame = 0
    const paint = () => {
      frame = 0
      const line = window.innerHeight * 0.35
      let current = headings[0]
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= line) current = heading
      }
      for (const link of links) {
        if (link.dataset.railSection === current.id) {
          link.setAttribute('aria-current', 'location')
        } else link.removeAttribute('aria-current')
      }
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(paint)
    }
    window.addEventListener('scroll', schedule, { passive: true })
    paint()
    stopRail = () => window.removeEventListener('scroll', schedule)
  }

  function setLook(look: BookLook) {
    root.setAttribute(BOOK_LOOK_ATTRIBUTE, look)
    try {
      localStorage.setItem(BOOK_LOOK_STORAGE_KEY, look)
    } catch {
      // Storage refused: the choice holds for this page only.
    }
    setDrawer(false)
    syncControls()
    syncMargin()
  }

  function toggleTheme() {
    const dark = !root.classList.contains('dark')
    root.classList.toggle('dark', dark)
    try {
      localStorage.setItem(THEME_STORAGE_KEY, dark ? 'dark' : 'theme-light')
    } catch {
      // Storage refused: the theme holds for this page only.
    }
    document.dispatchEvent(new CustomEvent(THEME_CHANGE_EVENT))
    syncControls()
  }

  // Delegated once for the whole session: the client router swaps the page
  // but keeps this module, so per-element listeners would be lost.
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null
    const choice = target?.closest('[data-book-look-choice]')
    if (choice) {
      const look = choice.getAttribute('data-book-look-choice')
      if (isBookLook(look)) setLook(look)
      return
    }
    if (target?.closest('[data-book-contents-toggle]')) {
      setDrawer(root.getAttribute('data-book-drawer') !== 'open')
      return
    }
    if (target?.closest('[data-book-theme-toggle]')) {
      toggleTheme()
      return
    }
    if (target?.closest('[data-book-edit]')) {
      document.querySelector<HTMLElement>('[data-edit-toggle]')?.click()
      return
    }
    if (target?.closest('[data-book-scrim]')) {
      setDrawer(false)
      return
    }
    // Following a link in the drawer closes it.
    if (target?.closest('#reading-navigation a')) setDrawer(false)
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    if (root.getAttribute('data-book-drawer') !== 'open') return
    setDrawer(false)
    document.querySelector<HTMLElement>('[data-book-contents-toggle]')?.focus()
  })

  document.addEventListener('astro:page-load', () => {
    setDrawer(false)
    syncControls()
    syncMargin()
    watchEdit()
    trackRail()
  })
  // The root's theme class also changes without this bar: the site menu, or
  // Head.astro following the OS while the stored theme is `system`.
  new MutationObserver(() => {
    syncControls()
    syncMargin()
  }).observe(root, {
    attributes: true,
    attributeFilter: ['class', BOOK_LOOK_ATTRIBUTE],
  })
  syncControls()
  syncMargin()
</script>

<style is:global>
  /* ---------- Both looks: the switch ---------- */
  .book-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    width: 100%;
    max-width: 90rem;
    margin: 0 auto 0.75rem;
    padding: 0 1rem;
  }

  .book-bar-start,
  .book-bar-end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .book-look {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font:
      0.75rem/1 ui-sans-serif,
      system-ui,
      sans-serif;
  }

  .book-look-label {
    margin-right: 0.25rem;
    color: hsl(var(--muted-foreground));
  }

  .book-look-choice {
    padding: 0.3rem 0.6rem;
    border: 1px solid hsl(var(--border));
    border-radius: 6px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
  }

  .book-look-choice[aria-pressed='true'] {
    border-color: hsl(var(--foreground));
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  /* The theme button sits beside the look switch in both looks, so the two
     choices about how the page looks are found in one place. */
  .book-bar-theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid hsl(var(--border));
    border-radius: 6px;
    background: transparent;
    color: hsl(var(--foreground));
    cursor: pointer;
  }

  .book-look-choice:focus-visible,
  .book-bar-button:focus-visible,
  .book-bar-link:focus-visible,
  .book-bar-title:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* The plain-only controls exist in both looks so the bar never re-renders;
     in `site` they take no space. */
  .book-bar-plain-only {
    display: none !important;
  }

  .book-scrim[hidden] {
    display: none;
  }

  /* ---------- Both looks: the chapter indicator ----------
     `render.py`'s NAV_CSS draws it from `--nav-*`; each look maps its own
     palette onto them. In `site` the bar that carries it stays pinned under
     the site header, so the reader always sees where they are in the chapter;
     in `plain` it sits in the middle of the plain bar, which is pinned
     already. */
  html {
    --nav-ink: hsl(var(--foreground));
    --nav-dim: hsl(var(--muted-foreground));
    --nav-line: hsl(var(--border));
    --nav-accent: #0369a1;
    --nav-panel: hsl(var(--background));
  }

  html.dark {
    --nav-accent: #7dd3fc;
  }

  html[data-book-look='plain'] {
    --nav-ink: var(--plain-ink);
    --nav-dim: var(--plain-dim);
    --nav-line: var(--plain-line);
    --nav-accent: var(--plain-accent);
    --nav-panel: var(--plain-panel);
  }

  /* Capped, so the step arrows stay beside the track rather than at the far
     edges of a wide window. */
  .book-bar-middle {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 44rem;
  }

  .book-bar[data-has-progress] {
    justify-content: space-between;
  }

  /* 4.25rem is the site header's measured height (68px at every width). */
  html:not([data-book-look='plain']) .book-bar[data-has-progress] {
    position: sticky;
    top: 4.25rem;
    z-index: 9;
    max-width: none;
    margin: 0 0 0.75rem;
    padding: 0.45rem max(1rem, calc((100% - 88rem) / 2));
    background: hsl(var(--background));
    border-bottom: 1px solid hsl(var(--border));
  }

  /* The shell pins its contents and margin columns under whatever is pinned
     above it; in `site` that is now the header and this bar. */
  html:not([data-book-look='plain'])
    .book-bar[data-has-progress]
    ~ .reading-shell {
    --reading-header: 7.25rem;
  }

  .book-content h2[id] {
    scroll-margin-top: 7.75rem;
  }

  html[data-book-look='plain'] .book-content h2[id] {
    scroll-margin-top: calc(var(--plain-bar-height) + 1rem);
  }

  /* On a phone the indicator takes a row of its own under the bar's
     controls, so neither squeezes the other off the screen. */
  @media (max-width: 640px) {
    .book-bar[data-has-progress] {
      flex-wrap: wrap;
      row-gap: 0.35rem;
    }

    .book-bar[data-has-progress] .book-bar-middle {
      order: 3;
      flex: 1 0 100%;
      max-width: none;
    }

    .book-bar[data-has-progress] .cp-keys {
      display: none;
    }

    .book-bar[data-has-progress] .book-look-label {
      display: none;
    }

    .book-content h2[id] {
      scroll-margin-top: 10.5rem;
    }
  }

  /* ---------- The plain look ---------- */
  html[data-book-look='plain'] {
    --plain-bg: #fbfbf9;
    --plain-ink: #1a1a1a;
    --plain-dim: #666;
    --plain-line: #e2e2e2;
    --plain-accent: #0369a1;
    --plain-panel: #fff;
    --plain-hover: #f0efe9;
    --plain-here: #e6f1f7;
    --plain-bar-height: 2.75rem;
    background: var(--plain-bg);
    color: var(--plain-ink);
  }

  html.dark[data-book-look='plain'] {
    --plain-bg: #161614;
    --plain-ink: #e8e6e1;
    --plain-dim: #9a9894;
    --plain-line: #34332f;
    --plain-accent: #7dd3fc;
    --plain-panel: #1c1c1a;
    --plain-hover: #25241f;
    --plain-here: #1d2d38;
  }

  html[data-book-look='plain'] body {
    background: var(--plain-bg);
    color: var(--plain-ink);
  }

  /* No personal-site chrome: the reader gets the book and its own bar. */
  html[data-book-look='plain'] body > div > header,
  html[data-book-look='plain'] body > div > footer {
    display: none;
  }

  html[data-book-look='plain'] body > div {
    gap: 0;
  }

  html[data-book-look='plain'] .book-bar-plain-only {
    display: flex !important;
  }

  html[data-book-look='plain'] .book-bar-plain-only[hidden] {
    display: none !important;
  }

  /* Map and Print, as the preview's bar has them. */
  html[data-book-look='plain'] .book-bar-link {
    color: var(--plain-accent);
    font:
      1.05rem/1.2 'Iowan Old Style',
      'Palatino Linotype',
      Georgia,
      serif;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  html[data-book-look='plain'] .book-bar-edit[aria-pressed='true'] {
    border-color: var(--plain-accent);
    background: var(--plain-accent);
    color: #fff;
  }

  /* Plain keeps the page quiet: the edit toolbar shows only while editing,
     started from the bar's one Edit button. */
  html[data-book-look='plain']:not([data-book-editing]) .edit-mode {
    display: none;
  }

  /* In plain the margin is its floating "Margin" button at every width; the
     column beside the text holds the chapter rail, as on the preview. */
  html[data-book-look='plain'] .reading-margin {
    position: fixed;
    top: auto;
    right: 0;
    bottom: 0;
    width: 0;
    height: 0;
    min-height: 0;
    max-height: none;
    overflow: visible;
    z-index: 30;
  }

  @media (min-width: 1280px) {
    html[data-book-look='plain'] .reading-companion {
      --ink: var(--plain-ink);
      --dim: var(--plain-dim);
      --line: var(--plain-line);
      --accent: var(--plain-accent);
      display: block;
      position: sticky;
      top: calc(var(--plain-bar-height) + 20px);
      align-self: start;
      max-height: calc(100vh - var(--plain-bar-height) - 46px);
      overflow-y: auto;
    }

    html[data-book-look='plain'] .reading-companion .rail {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  html[data-book-look='plain'] .book-bar {
    position: sticky;
    top: 0;
    z-index: 16;
    justify-content: space-between;
    max-width: none;
    min-height: var(--plain-bar-height);
    margin: 0;
    padding: 0.4rem 1rem;
    background: var(--plain-bg);
    border-bottom: 1px solid var(--plain-line);
  }

  html[data-book-look='plain'] .book-bar-middle {
    max-width: 34rem;
    margin: 0 auto;
  }

  /* Two rows on a phone: the bar is that much taller, and everything that
     sits under it (the drawer, the scrim, the shell's pinned columns, a
     heading brought into view) reads the height from this one variable. */
  @media (max-width: 640px) {
    html[data-book-look='plain']:has(.book-bar[data-has-progress]) {
      --plain-bar-height: 5.1rem;
    }

    html[data-book-look='plain'] .book-bar[data-has-progress] .book-bar-title {
      display: none;
    }
  }

  html[data-book-look='plain'] .book-bar-button {
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--plain-line);
    border-radius: 6px;
    background: var(--plain-panel);
    color: var(--plain-ink);
    font:
      600 0.8rem/1.2 ui-sans-serif,
      system-ui,
      sans-serif;
    cursor: pointer;
  }

  html[data-book-look='plain'] .book-bar-title {
    overflow: hidden;
    color: var(--plain-accent);
    font:
      600 0.9rem/1.2 ui-sans-serif,
      system-ui,
      sans-serif;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  html[data-book-look='plain'] .book-look-label {
    color: var(--plain-dim);
  }

  html[data-book-look='plain'] .book-look-choice {
    border-color: var(--plain-line);
    background: var(--plain-panel);
    color: var(--plain-dim);
  }

  html[data-book-look='plain'] .book-look-choice[aria-pressed='true'] {
    border-color: var(--plain-accent);
    color: var(--plain-ink);
  }

  html[data-book-look='plain'] .book-bar-theme {
    width: 2rem;
    height: 1.9rem;
    padding: 0;
  }

  /* A sun in the dark theme (the way out), a moon in the light one. */
  .book-theme-icon::before {
    content: '\263E';
    font-size: 0.95rem;
  }

  html.dark .book-theme-icon::before {
    content: '\2600';
  }

  html[data-book-look='plain'] .book-bar-progress {
    align-items: center;
    gap: 0.5rem;
  }

  .book-bar-progress-bar {
    width: 7.5rem;
    height: 5px;
    overflow: hidden;
    border-radius: 3px;
    background: var(--plain-line);
  }

  .book-bar-progress-bar i {
    display: block;
    height: 100%;
    background: var(--plain-accent);
  }

  .book-bar-progress-text {
    color: var(--plain-dim);
    font:
      0.72rem ui-sans-serif,
      system-ui,
      sans-serif;
    white-space: nowrap;
  }

  /* One serif column on the off-white page, the chapter rail beside it when
     there is room. The contents column leaves the grid and becomes a drawer,
     and the margin is its floating button. `[data-margin-default]` so a shell
     that asked for a collapsed margin (the map, the print edition) still
     takes this grid rather than the site's. */
  html[data-book-look='plain'] .reading-shell[data-margin-default] {
    --reading-header: var(--plain-bar-height);
    --reading-gap: 1.25rem;
    grid-template-columns: minmax(0, 40rem);
    justify-content: center;
    gap: 3rem;
    max-width: none;
    padding: 28px 24px 80px;
  }

  @media (min-width: 1280px) {
    html[data-book-look='plain'] .reading-shell[data-margin-default] {
      grid-template-columns: minmax(0, 40rem) 17rem;
    }
  }

  html[data-book-look='plain'] .reading-text {
    font:
      17px/1.65 'Iowan Old Style',
      'Palatino Linotype',
      Georgia,
      serif;
  }

