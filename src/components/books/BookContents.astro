---
/** The book's contents, in reading order, for the navigation column. */
import type { Book, BookNode } from '@/lib/books'

type Props = {
  book: Book
  currentId?: string
  /** The "Contents" label and the book's title above the list; off where the page already says both. */
  heading?: boolean
}

const { book, currentId, heading = true } = Astro.props

/**
 * What must be solved for an entry to count as done: a challenge itself, or
 * every exercise in a chapter. Entries with neither never show a tick. The
 * page code (`books/tools/runtime/book-progress.mjs`) sets `data-progress-done`.
 */
function progressItems(node: BookNode): string | undefined {
  if (node.kind === 'challenge') return node.id
  return node.exercises.length > 0 ? node.exercises.join(' ') : undefined
}

const byId = new Map<string, BookNode>(
  book.nodes.map((node) => [node.id, node]),
)
const intro = book.nodes.filter((node) => !node.partNumber)
const parts = book.parts.map((part) => ({
  title: part.title,
  entries: part.nodes
    .map((id) => byId.get(id))
    .filter((node): node is BookNode => Boolean(node)),
}))
---

{
  heading && (
    <>
      <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        Contents
      </p>
      <a
        class="mb-4 block text-sm font-semibold hover:underline hover:underline-offset-4"
        href={book.path}
      >
        {book.title}
      </a>
    </>
  )
}

<ol class="flex flex-col gap-y-4 text-sm">
  {
    intro.length > 0 && (
      <li>
        <ol class="flex flex-col gap-y-1">
          {intro.map((node) => (
            <li>
              <a
                class:list={[
                  'block rounded px-1 py-0.5 hover:underline hover:underline-offset-4',
                  node.id === currentId
                    ? 'font-semibold text-foreground'
                    : 'text-muted-foreground',
                ]}
                href={node.path}
                aria-current={node.id === currentId ? 'page' : undefined}
                data-progress-items={progressItems(node)}
              >
                {node.title}
                <span class="progress-tick" aria-hidden="true">✓</span>
                <span class="progress-solved sr-only">(solved)</span>
              </a>
            </li>
          ))}
        </ol>
      </li>
    )
  }
  {
    parts.map((part) => (
      <li>
        <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          {part.title}
        </p>
        <ol class="flex flex-col gap-y-1">
          {part.entries.map((node) => (
            <li>
              <a
                class:list={[
                  'flex gap-x-2 rounded px-1 py-0.5 hover:underline hover:underline-offset-4',
                  node.id === currentId
                    ? 'font-semibold text-foreground'
                    : 'text-muted-foreground',
                ]}
                href={node.path}
                aria-current={node.id === currentId ? 'page' : undefined}
                data-progress-items={progressItems(node)}
              >
                <span class="tabular-nums opacity-70">{node.number}</span>
                <span>{node.title}</span>
                <span class="progress-tick" aria-hidden="true">✓</span>
                <span class="progress-solved sr-only">(solved)</span>
              </a>
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>

<style>
  /* Shown once the page code marks an entry done; nothing to see before then. */
  .progress-tick,
  .progress-solved {
    display: none;
  }
  [data-progress-done] .progress-tick {
    display: inline;
    color: #15803d;
  }
  :global(.dark) [data-progress-done] .progress-tick {
    color: #4ade80;
  }
  [data-progress-done] .progress-solved {
    display: inline;
  }
</style>
