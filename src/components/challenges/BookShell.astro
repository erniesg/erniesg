---
/**
 * The page the book is read in: contents, text, margin.
 *
 * The middle column is whatever `challenges/tools/render.py` returned, embedded
 * verbatim by the caller into this component's slot. This file contributes no
 * block markup and no block styling — only the columns around the text and the
 * navigation chrome the site owns. The stylesheet and the figure-stepping
 * script both come from the renderer, so a figure looks and behaves the same
 * here as it does in the local reader.
 *
 * The right-hand column is deliberately empty. It is the landmark 056-060 mount
 * into, and it holds a fixed grid track, so filling it later cannot move the
 * text column a pixel.
 */
import type { ChallengesBook, ChallengesNode } from '@/lib/challenges-book'

type Props = {
  book: ChallengesBook
  current?: ChallengesNode | null
  documentUri: string
}

const { book, current = null, documentUri } = Astro.props

const outline = current?.outline.filter((heading) => heading.level === 2) ?? []
const edges = current?.edges ?? []
---

<style is:inline set:html={book.css}></style>

<div class="book-page">
  <div class="book-shell">
    <details class="book-toc" open>
      <summary>Contents</summary>
      <div class="book-toc-inner">
        {
          outline.length > 0 && (
            <nav aria-label="In this chapter">
              <p class="book-rail-title">In this chapter</p>
              <ol class="book-rail-list">
                {outline.map((heading) => (
                  <li>
                    <a href={`#${heading.id}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <nav aria-label="Book contents">
          <p class="book-rail-title">
            <a href={`${book.base}/`}>{book.book.title}</a>
          </p>
          {
            book.contents.map((part) => (
              <>
                <p class="book-part">{part.title}</p>
                <ol class="book-toc-list">
                  {part.nodes.map((row) => (
                    <li class={row.id === current?.id ? 'book-here' : undefined}>
                      <a
                        href={row.path}
                        aria-current={
                          row.id === current?.id ? 'page' : undefined
                        }
                      >
                        {row.number && (
                          <span class="book-num">{row.number}</span>
                        )}
                        <span>{row.title}</span>
                      </a>
                    </li>
                  ))}
                  {part.planned.map((topic) => (
                    <li class="book-planned">
                      <span>{topic.title}</span>
                      <span class="book-soon">to come</span>
                    </li>
                  ))}
                </ol>
              </>
            ))
          }
        </nav>

        {
          edges.length > 0 && (
            <nav aria-label="Connected nodes">
              <p class="book-rail-title">Connected</p>
              <ul class="book-rail-list">
                {edges.map((edge) => (
                  <li>
                    <span class="book-edge-label">{edge.label}</span>
                    {edge.path ? (
                      <a href={edge.path}>{edge.title}</a>
                    ) : (
                      <span class="book-planned">{edge.title}</span>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </details>

    <article
      class="book-text"
      data-document-uri={documentUri}
      data-node-id={current?.id}
    >
      <slot />
    </article>

    <aside
      class="book-margin"
      id="book-margin"
      data-margin-mount="true"
      aria-label="Margin"
    >
      <div class="book-margin-notes" data-margin-notes="true"></div>
    </aside>
  </div>
</div>

<script is:inline set:html={book.script}></script>

<style>
  .book-page {
    margin-inline: auto;
    width: 100%;
    max-width: 84rem;
    padding: 1.5rem 1rem 4rem;
  }

  /* One column on a phone, two once there is room for the contents, and the
     margin only above 1280px — the same breakpoint the local reader drops its
     rail at. The margin is a fixed track, so notes landing in it later cannot
     reflow the text column. */
  .book-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .book-margin {
    display: none;
    min-width: 0;
    position: sticky;
    top: 5rem;
  }

  @media (min-width: 768px) {
    .book-shell {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .book-shell {
      grid-template-columns: 15rem minmax(0, 44rem) 18rem;
      justify-content: center;
    }

    .book-margin {
      display: block;
    }
  }

  /* The book is a book: it reads on its own paper in either site theme, and
     the renderer's colours are the paper. */
  .book-text {
    min-width: 0;
    color-scheme: light;
    background: var(--bg);
    color: var(--ink);
    border-radius: 0.5rem;
    padding: 0.25rem 0.25rem 2rem;
    font:
      17px/1.65 'Iowan Old Style',
      'Palatino Linotype',
      Georgia,
      serif;
  }

  .book-toc {
    min-width: 0;
    font:
      0.85rem / 1.5 ui-sans-serif,
      system-ui;
  }

  .book-toc > summary {
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .book-toc-inner {
    margin-top: 0.8rem;
  }

  @media (min-width: 1280px) {
    .book-toc-inner {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  .book-rail-title {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.7rem;
    opacity: 0.7;
    margin: 1.4rem 0 0.4rem;
  }

  .book-rail-title:first-child {
    margin-top: 0;
  }

  .book-part {
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.68rem;
    opacity: 0.6;
    margin: 1.1rem 0 0.3rem;
  }

  .book-toc-list,
  .book-rail-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .book-toc-list li,
  .book-rail-list li {
    margin: 0.15rem 0;
  }

  .book-toc-list a,
  .book-rail-list a {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.2rem 0.4rem;
    border-radius: 0.35rem;
    text-decoration: none;
  }

  .book-toc-list a:hover,
  .book-rail-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .book-here > a {
    font-weight: 600;
  }

  .book-num {
    opacity: 0.55;
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
  }

  .book-planned,
  .book-soon {
    opacity: 0.55;
  }

  .book-soon {
    font-style: italic;
    font-size: 0.7rem;
    margin-left: 0.4rem;
  }

  .book-edge-label {
    display: block;
    font-size: 0.68rem;
    opacity: 0.6;
  }
</style>
