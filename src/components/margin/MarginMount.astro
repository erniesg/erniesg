---
/**
 * The margin layer, mounted into the reading shell's landmark.
 *
 * All of the behaviour is `@erniesg/margin`, which is a standalone package
 * that knows nothing about this site. This file is the whole of the binding:
 * one element, one attribute, and the call that registers the element. There
 * is deliberately nothing here for the package to grow a dependency on.
 *
 * The import is relative because `packages/margin/` is published rather than
 * installed — see that package's README.
 */
type Props = {
  /** The stable identity annotations are stored against. */
  documentUri: string
  /**
   * Where the margin service lives. The Worker serves it on this site's own
   * origin, so the default is the origin root; a page with no service behind
   * it (the dev server) gets a 404 on load, which the rail treats as "no
   * service here" and keeps working in memory.
   */
  apiBase?: string
  /** Below this width the rail is a toggle and an overlay, not a column. */
  collapseBelow?: number
}

const { documentUri, apiBase = '/', collapseBelow } = Astro.props
---

<margin-rail
  document-uri={documentUri}
  api-base={apiBase}
  collapse-below={collapseBelow}></margin-rail>

<script>
  import { defineMarginElements } from '../../../packages/margin/src/index'

  defineMarginElements()
</script>
