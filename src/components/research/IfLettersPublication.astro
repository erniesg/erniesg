---
import Container from '@/components/Container.astro'
import { Content as PaperContent } from '@/research/publications/if-letters-home-could-sing.md'
import type { ResearchPaper } from '@/research/schema'

type Props = { paper: ResearchPaper }

const { paper } = Astro.props

const sections = [
  [
    'Introduction',
    'introduction-the-politics-of-transnational-chinese-correspondence',
  ],
  ['New museology', 'new-museology-and-embodied-experience-applied'],
  [
    'Methodology',
    'methodology-from-content-to-experience---letters-heartbeats-and-sound',
  ],
  ['Implications', 'implications'],
  ['Conclusion', 'conclusion-and-future-research'],
  ['Acknowledgments', 'acknowledgments'],
  ['References', 'references'],
]
---

<Container class="research-shell letters-publication pb-24">
  <a class="letters-back" href="/research">← Research</a>

  <header class="letters-hero">
    <p class="letters-kicker">
      National Museum of Singapore · Research Fellowship 2024
    </p>
    <h1>{paper.title}</h1>
    <p class="letters-subtitle">{paper.subtitle}</p>
    <p class="letters-byline">Chen Enjiao (Ernie) · Research Fellow</p>

    <figure class="letters-hero__artifact">
      <img
        src="/research/if-letters-home-could-sing/media/image3.jpg"
        alt="Remittance letter from He Aifang to He Qinge, dated 2 March 1960"
      />
      <figcaption>
        He Aifang to He Qinge, 2 March 1960. National Museum of Singapore,
        accession no. 2000-06963-004.
      </figcaption>
    </figure>
  </header>

  <section
    class="letters-publication-note"
    aria-label="Publication acknowledgement"
  >
    <p>
      This research was supported by the <strong>National Heritage Board</strong
      >
      through the National Museum of Singapore’s 2024 Research Fellowship programme.
    </p>
    <p>
      The opinions, findings, and recommendations expressed in this publication
      are those of the Research Fellow and do not necessarily reflect the views
      of the National Heritage Board.
    </p>
  </section>

  <nav class="letters-actions" aria-label="Publication downloads and source">
    <a
      href="/research/if-letters-home-could-sing/if-letters-home-could-sing.pdf"
      download
    >
      Download PDF
    </a>
    <a
      href="/research/if-letters-home-could-sing/if-letters-home-could-sing.epub"
      download
    >
      Download EPUB
    </a>
    <a href={`/research/${paper.id}/source.json`}>View source</a>
  </nav>

  <section class="letters-abstract" aria-labelledby="letters-abstract-title">
    <h2 id="letters-abstract-title">Abstract</h2>
    <p>
      This research explores the intersection of cultural heritage, interactive
      design, and embodied experience to transform static historical Chinese
      diaspora correspondence into dynamic, living encounters. Focusing on
      <em>qiao pi</em> (侨批), or “letters home,” it centres Hainanese women’s voices
      and brings their “history from below” to life through heart rate-synchronised
      sound experiences.
    </p>
  </section>

  <nav class="letters-toc" aria-label="Paper contents">
    <h2>Contents</h2>
    <ol>
      {
        sections.map(([title, anchor]) => (
          <li>
            <a href={`#${anchor}`}>{title}</a>
          </li>
        ))
      }
    </ol>
  </nav>

  <article class="letters-paper">
    <PaperContent />
  </article>
</Container>

<style is:global>
  .letters-publication {
    background: hsl(var(--background));
    color: hsl(var(--foreground));
  }

  .letters-back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }

  .letters-back:hover,
  .letters-actions a:hover,
  .letters-toc a:hover {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .letters-hero {
    border-bottom: 1px solid hsl(var(--border));
    padding-bottom: 2rem;
  }

  .letters-kicker,
  .letters-byline,
  .letters-hero figcaption {
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .letters-hero h1 {
    margin-top: 0.75rem;
    max-width: 18ch;
    font-size: clamp(2.25rem, 8vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .letters-subtitle {
    margin-top: 1rem;
    max-width: 52ch;
    color: hsl(var(--muted-foreground));
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.55;
  }

  .letters-byline {
    margin-top: 1rem;
  }

  .letters-hero__artifact {
    margin: 2rem 0 0;
  }

  .letters-hero__artifact img {
    display: block;
    max-height: 34rem;
    width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .letters-hero__artifact figcaption {
    margin-top: 0.75rem;
  }

  .letters-publication-note {
    display: grid;
    gap: 1rem;
    border-bottom: 1px solid hsl(var(--border));
    padding: 1.5rem 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .letters-publication-note p {
    margin: 0;
  }

  .letters-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    border-bottom: 1px solid hsl(var(--border));
    padding: 1.25rem 0;
    font-size: 0.875rem;
  }

  .letters-actions a {
    border-bottom: 1px solid hsl(var(--muted-foreground));
    padding-bottom: 0.15rem;
  }

  .letters-abstract {
    border-bottom: 1px solid hsl(var(--border));
    padding: 3rem 0;
  }

  .letters-abstract h2,
  .letters-toc h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .letters-abstract p {
    margin: 0;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    line-height: 1.65;
  }

  .letters-toc {
    border-bottom: 1px solid hsl(var(--border));
    padding: 2rem 0;
  }

  .letters-toc ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .letters-paper {
    max-width: none;
    padding-top: 4rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  .letters-paper h1 {
    margin: 5rem 0 1.5rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1.5rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .letters-paper > :first-child {
    margin-top: 0;
  }

  .letters-paper h2 {
    margin: 3.5rem 0 1rem;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .letters-paper h3 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .letters-paper p,
  .letters-paper ol,
  .letters-paper ul {
    margin: 1rem 0;
  }

  .letters-paper ol,
  .letters-paper ul {
    padding-left: 1.5rem;
  }

  .letters-paper li {
    margin: 0.65rem 0;
  }

  .letters-paper blockquote {
    margin: 2rem 0;
    border-left: 2px solid hsl(var(--border));
    padding-left: 1.25rem;
    color: hsl(var(--muted-foreground));
  }

  .letters-paper figure {
    margin: 2.5rem 0;
  }

  .letters-paper figure img {
    display: block;
    max-height: 48rem;
    width: 100%;
    object-fit: contain;
  }

  .letters-paper figcaption {
    margin-top: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .letters-system-diagram svg {
    display: block;
    width: 100%;
    height: auto;
    color: hsl(var(--foreground));
  }

  .letters-system-diagram {
    max-width: 32rem;
    margin-inline: auto;
  }

  .letters-system-diagram .diagram-group,
  .letters-system-diagram .diagram-node {
    fill: hsl(var(--background));
    stroke: currentColor;
    vector-effect: non-scaling-stroke;
  }

  .letters-system-diagram .diagram-group {
    stroke: hsl(var(--border));
  }
  .letters-system-diagram .diagram-line {
    fill: none;
    stroke: currentColor;
    vector-effect: non-scaling-stroke;
  }

  .letters-system-diagram text {
    fill: currentColor;
    font-family: Geist, ui-sans-serif, system-ui, sans-serif;
  }

  @media (min-width: 640px) {
    .letters-publication-note {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .letters-toc ol {
      grid-template-columns: 1fr;
    }
    .letters-paper {
      line-height: 1.68;
    }
  }

  @media (monochrome), (forced-colors: active) {
    .letters-publication {
      background: Canvas;
      color: CanvasText;
    }
  }

  @media print {
    @page {
      margin: 18mm;
      size: A4;
    }
    body > div > header,
    body > div > footer,
    .letters-back,
    .letters-actions,
    .letters-toc {
      display: none !important;
    }
    .letters-publication {
      max-width: none;
      padding: 0;
    }
    .letters-hero h1 {
      font-size: 36pt;
    }
    .letters-paper {
      font-size: 10.5pt;
    }
    .letters-paper h1 {
      break-before: page;
    }
    .letters-paper figure {
      break-inside: avoid;
    }
  }
</style>
