---
import { representingTasteProject } from '@/research/representing-taste'
import { structProject } from '@/research/struct-project'
---

<section class="flex flex-col gap-y-4" aria-labelledby="research-projects">
  <h2 id="research-projects" class="text-2xl font-semibold">
    Research projects
  </h2>
  <ul class="border-t">
    <li class="border-b py-6">
      <a
        class="group flex flex-col gap-y-2"
        href={representingTasteProject.path}
      >
        <small class="text-xs text-muted-foreground"
          >{representingTasteProject.status}</small
        >
        <h3
          class="text-xl font-semibold group-hover:underline group-hover:underline-offset-4"
        >
          {representingTasteProject.title}
        </h3>
        <p class="text-sm leading-relaxed text-muted-foreground">
          {representingTasteProject.summary}
        </p>
        <span class="text-sm text-muted-foreground">
          First supporting milestone: <a
            class="underline underline-offset-4"
            href={structProject.demoPath}>Struct’s live PDF-import demo</a
          >
        </span>
      </a>
    </li>
  </ul>
</section>
