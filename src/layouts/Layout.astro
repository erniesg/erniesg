---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { DEFAULT_LOCALE, LOCALE_HTML_LANG, type SupportedLocale } from '@/lib/i18n'

type Props = {
  title: string
  description: string
  image?: string
  lang?: SupportedLocale
  canonicalPath?: string
  alternates?: Partial<Record<SupportedLocale, string>>
}

const {
  title,
  description,
  image,
  lang = DEFAULT_LOCALE,
  canonicalPath,
  alternates,
} = Astro.props
---

<!doctype html>
<html lang={LOCALE_HTML_LANG[lang]}>
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      lang={lang}
      canonicalPath={canonicalPath}
      alternates={alternates}
    />
  </head>
  <body>
    <div
      class="box-border flex h-fit min-h-screen flex-col gap-y-6 font-sans antialiased"
    >
      <Header />
      <main class="flex-grow">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
