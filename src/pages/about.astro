---
import AuthorCard from '@/components/AuthorCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getStaticTranslation } from '@/lib/i18n'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
const author = (await getCollection('authors')).find(author => author.id === 'erniesg')
---

<Layout title="About" description={SITE.DESCRIPTION}>
  <Container class="flex flex-col gap-y-6">
    <Breadcrumbs
      items={[
        { label: getStaticTranslation('about.title', 'en'), icon: 'lucide:info', i18nKey: 'about.title' },
      ]}
    />

    {author && <AuthorCard author={author} />}

    <section>
      <div class="min-w-full">
        <div class="prose prose-neutral mb-8 dark:prose-invert">
          <p class="mb-4" data-i18n-key="about.copy">
            {getStaticTranslation('about.copy', 'en')}
          </p>
        </div>

        <h2
          class="mb-4 text-2xl font-semibold"
          data-i18n-key="about.featuredProjects"
        >
          {getStaticTranslation('about.featuredProjects', 'en')}
        </h2>
        <div class="flex flex-col gap-4">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  </Container>
</Layout>
