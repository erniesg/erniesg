---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PostNavigation from '@/components/PostNavigation.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import { badgeVariants } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'
import Layout from '@/layouts/Layout.astro'
import { parseAuthors } from '@/lib/server-utils'
import { formatDate, readingTime } from '@/lib/utils'
import {
  DEFAULT_LOCALE,
  SUPPORTED_LOCALES,
  type SupportedLocale,
  getCanonicalPostId,
  getLocaleFromPostId,
  getPostLocalePath,
  getStaticTranslation,
  getTagLabel,
  isCanonicalDefaultPostId,
  isLegacyChinesePostId,
} from '@/lib/i18n'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { type CollectionEntry, getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter(
      (post) =>
        (import.meta.env.DEV || !post.data.draft) &&
        !isLegacyChinesePostId(post.id),
    )
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }))
}
type Props = CollectionEntry<'blog'>

const allPosts = (await getCollection('blog')).filter(
  (post) => !post.data.draft && !isLegacyChinesePostId(post.id),
)

const posts = allPosts
  .filter((post) => isCanonicalDefaultPostId(post.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

function getPostIndex(id: string): number {
  return posts.findIndex((post) => post.id === id)
}

function getPrevPost(id: string): Props | null {
  const postIndex = getPostIndex(id)
  return postIndex !== -1 && postIndex < posts.length - 1
    ? posts[postIndex + 1]
    : null
}

function getNextPost(id: string): Props | null {
  const postIndex = getPostIndex(id)
  return postIndex > 0 ? posts[postIndex - 1] : null
}

function getLocalizedSibling(
  post: Props | null,
  locale: SupportedLocale,
): Props | null {
  if (!post) return null

  return (
    allPosts.find(
      (entry) =>
        getCanonicalPostId(entry.id) === post.id &&
        getLocaleFromPostId(entry.id) === locale,
    ) ?? post
  )
}

const post = Astro.props
const canonicalPostId = getCanonicalPostId(post.id)
const currentLocale = getLocaleFromPostId(post.id)
const nextPost = getLocalizedSibling(getNextPost(canonicalPostId), currentLocale)
const prevPost = getLocalizedSibling(getPrevPost(canonicalPostId), currentLocale)
const { Content, headings } = await render(post)

const authors = await parseAuthors(post.data.authors ?? [], currentLocale)
const translatedPosts = allPosts.filter(
  (entry) => getCanonicalPostId(entry.id) === canonicalPostId,
)
const availableLocales = SUPPORTED_LOCALES.filter((locale) =>
  translatedPosts.some((entry) => getLocaleFromPostId(entry.id) === locale),
)
function getLocalizedEntryPath(locale: SupportedLocale) {
  const entry = translatedPosts.find(
    (item) => getLocaleFromPostId(item.id) === locale,
  )
  return entry ? getPostLocalePath(entry.id, locale) : null
}
const alternates = Object.fromEntries(
  availableLocales.flatMap((locale) => {
    const path = getLocalizedEntryPath(locale)
    return path ? [[locale, path]] : []
  }),
) as Partial<Record<SupportedLocale, string>>
const localizedPaths = Object.fromEntries(
  availableLocales.flatMap((locale) => {
    const path = getLocalizedEntryPath(locale)
    return path ? [[locale, path]] : []
  }),
) as Partial<Record<SupportedLocale, string>>
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image?.src ?? '/static/1200x630.png'}
  lang={currentLocale}
  canonicalPath={getPostLocalePath(post.id, currentLocale)}
  alternates={alternates}
>
  <section
    class="grid grid-cols-[minmax(0px,1fr)_min(768px,100%)_minmax(0px,1fr)] gap-y-6 *:px-4"
  >
    <Breadcrumbs
      items={[
        {
          href: '/blog',
          label: getStaticTranslation('blog.title', currentLocale),
          icon: 'lucide:archive',
          i18nKey: 'blog.title',
        },
        { label: post.data.title, icon: 'lucide:file-text' },
      ]}
      class="col-start-2"
    />
    {
      post.data.image && (
        <Image
          src={post.data.image}
          alt={post.data.title}
          width={1200}
          height={630}
          class="col-span-full mx-auto w-full max-w-[1000px] object-cover"
        />
      )
    }
    <section class="col-start-2 flex flex-col gap-y-6 text-center">
      <div class="flex flex-col gap-y-4">
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl">
          {post.data.title}
        </h1>

        <div
          class="flex flex-wrap items-center justify-center gap-2 text-sm text-muted-foreground"
        >
          {
            authors.length > 0 && (
              <>
                <div class="flex items-center gap-x-2">
                  {authors.map((author) => (
                    <div class="flex items-center gap-x-1.5">
                      <Image
                        src={author.avatar}
                        alt={author.name}
                        width={24}
                        height={24}
                        class="rounded-full"
                      />
                      {author.isRegistered ? (
                        <Link
                          href={`/authors/${author.id}`}
                          underline
                          class="text-foreground"
                        >
                          <span data-i18n-key={`author.${author.id}.name`}>
                            {author.name}
                          </span>
                        </Link>
                      ) : (
                        <span data-i18n-key={`author.${author.id}.name`}>
                          {author.name}
                        </span>
                      )}
                    </div>
                  ))}
                </div>
                <Separator orientation="vertical" className="h-4" />
              </>
            )
          }
          <div class="flex items-center gap-2">
            <span>{formatDate(post.data.date, currentLocale)}</span>
            <Separator orientation="vertical" className="h-4" />
            <span>{readingTime(post.body!, currentLocale)}</span>
          </div>
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          {
            post.data.tags && post.data.tags.length > 0 ? (
              post.data.tags.map((tag) => (
                <a
                  href={`/tags/${tag}`}
                  class={badgeVariants({ variant: 'secondary' })}
                >
                  <Icon name="lucide:hash" class="size-3 -translate-x-0.5" />
                  {getTagLabel(tag, currentLocale)}
                </a>
              ))
            ) : (
              <span class="text-sm text-muted-foreground">
                {getStaticTranslation('blog.noTags', currentLocale)}
              </span>
            )
          }
        </div>
      </div>

      <PostNavigation
        prevPost={prevPost}
        nextPost={nextPost}
        locale={currentLocale}
      />
    </section>

    {headings.length > 0 && <TableOfContents headings={headings} />}

    <article
      class="prose prose-neutral col-start-2 max-w-none dark:prose-invert"
    >
      <Content />
    </article>

    <PostNavigation
      prevPost={prevPost}
      nextPost={nextPost}
      locale={currentLocale}
    />
  </section>

  <Button
    variant="outline"
    size="icon"
    className="group fixed bottom-8 right-8 z-50 hidden"
    id="scroll-to-top"
    title={getStaticTranslation('ui.scrollToTop', currentLocale)}
    aria-label={getStaticTranslation('ui.scrollToTop', currentLocale)}
  >
    <Icon
      name="lucide:arrow-up"
      class="mx-auto size-4 transition-all group-hover:-translate-y-0.5"
    />
  </Button>

  {
    currentLocale === DEFAULT_LOCALE && availableLocales.length > 1 && (
      <script is:inline define:vars={{ localizedPaths }}>
        document.addEventListener('astro:page-load', () => {
          const savedLocale =
            localStorage.getItem('siteLang') ?? localStorage.getItem('blogLang')
          const languages = navigator.languages ?? [navigator.language]
          const supportedLocales = ['zh', 'ko', 'ja', 'en']
          const detectedLocale = languages
            .map((language) => language.toLowerCase().split('-')[0])
            .find((locale) => supportedLocales.includes(locale))
          const preferredLocale = supportedLocales.includes(savedLocale)
            ? savedLocale
            : detectedLocale

          if (
            preferredLocale &&
            preferredLocale !== 'en' &&
            localizedPaths[preferredLocale]
          ) {
            if (!savedLocale) localStorage.setItem('siteLang', preferredLocale)
            window.location.assign(localizedPaths[preferredLocale])
          }
        })
      </script>
    )
  }

  <script>
    document.addEventListener('astro:page-load', () => {
      const scrollToTopButton = document.getElementById('scroll-to-top')
      const footer = document.querySelector('footer')

      if (scrollToTopButton && footer) {
        scrollToTopButton.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' })
        })

        window.addEventListener('scroll', () => {
          const footerRect = footer.getBoundingClientRect()
          const isFooterVisible = footerRect.top <= window.innerHeight

          scrollToTopButton.classList.toggle(
            'hidden',
            window.scrollY <= 300 || isFooterVisible,
          )
        })
      }
    })
  </script>
</Layout>
