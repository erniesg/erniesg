---
import BookHistory from '@/components/BookHistory.astro'
import BookBar from '@/components/books/BookBar.astro'
import BookContents from '@/components/books/BookContents.astro'
import BookProgress from '@/components/books/BookProgress.astro'
import EditMode from '@/components/books/EditMode.astro'
import ReadingLayout from '@/layouts/ReadingLayout.astro'
import {
  bookBySlug,
  bookManifest,
  books,
  documentUri,
  nodeSourceStamp,
  scopeContentCss,
  withHistoryPublicationWitness,
} from '@/lib/books'

export function getStaticPaths() {
  // Full build HEAD differs from the last-touch source stamp. Dev keeps
  // ordinary editing and shows history unavailable without a strict identity.
  const historyBuild = import.meta.env.DEV
    ? ''
    : withHistoryPublicationWitness(process.cwd(), ({ head }) => head)
  return books().flatMap((book) =>
    book.nodes.map((node) => ({ params: { book: book.slug, node: node.id }, props: { historyBuild } })),
  )
}

const slug = Astro.params.book!
const nodeId = Astro.params.node!
const book = bookBySlug(slug)
if (!book) throw new Error(`no book path declares the slug \`${slug}\``)

const index = book.nodes.findIndex((entry) => entry.id === nodeId)
const node = book.nodes[index]
if (!node) throw new Error(`\`${slug}\` has no node \`${nodeId}\``)

// A challenge's tiers, for the grader in the reader's browser. `<` is escaped
// so a test file that mentions a closing script tag cannot end this one early.
const grading = node.grading ? JSON.stringify(node.grading).replace(/</g, '\\u003c') : null

const uri = documentUri(node.path)

// What this page was built from, for edit proposals (issue 059). The source
// text travels with the page so the editor diffs against exactly the commit it
// names; `<` is escaped for the same reason as the grading data above.
const stamp = nodeSourceStamp(node, import.meta.env.DEV)
const sourceJson = stamp.source === null
  ? null
  : JSON.stringify({ path: stamp.sourcePath, commit: stamp.sourceCommit, text: stamp.source }).replace(/</g, '\\u003c')

// The book's own stylesheet, confined to the rendered node. The site's reset
// zeroes things a book assumes — list markers, heading weight, paragraph
// spacing — so the few rules that put them back are the site's business and
// stay here rather than in the renderer.
const RESTORED = `
/* The container itself keeps the site's foreground over the site's background,
   in either theme. In the light theme the panels CONTENT_CSS gives a
   hard-coded light background pin a dark foreground to go with it: inline code
   is one of those panels; code inside a \`pre\` is not, because \`pre\`
   carries its own pair. */
.book-content { overflow-wrap: anywhere; }
.book-content .figure,
.book-content .cell,
.book-content .hint,
.book-content .solution,
.book-content :not(pre) > code { color: #1a1a1a; }
/* CONTENT_CSS's greys, its rules and its link colour are all chosen against a
   light page — --ink draws the rules above and below a challenge card, so at
   #1a1a1a on the dark page the card loses its boundary entirely. They get dark
   values on the container, and so do the panels: a white figure card or code
   chip on the dark page glares, so in the dark theme each panel is a dark
   card (the plain look's panel colour where it has one) with the page's own
   light foreground. A walk figure's highlighted step keeps its amber fill and
   takes a dark foreground to go with it. */
.dark .book-content { --ink: #ededed; --dim: #a3a19c; --line: #3f3f3f; --accent: #7dd3fc; --bg: #232320; }
.dark .book-content .figure,
.dark .book-content .cell,
.dark .book-content .hint,
.dark .book-content .solution {
  background: var(--plain-panel, #1c1c1a);
  color: #e8e6e1;
  /* Every outline drawn inside a panel (table borders, step boxes, button
     borders, diagram boxes) is a graphic, so it keeps 3:1 on the card. */
  --line: #8a8780;
}
.dark .book-content :not(pre) > code { background: #2c2b27; color: #ece9e2; }
.dark .book-content figcaption,
.dark .book-content .pairs dd { color: #b9b6af; }
.dark .book-content .figure button { background: #26251f; color: #e8e6e1; border-color: var(--line); }
.dark .book-content .walk-item.on { color: #1a1a1a; }
/* The renderer draws its SVG figures with fixed light-theme colours as
   presentation attributes, which CSS overrides: a cost chart's tick labels,
   axis and series, and a links diagram's boxes, labels and edges. Series
   keep their order and hue, lightened for the dark card. */
.dark .book-content svg.cost text { fill: #b9b6af; }
.dark .book-content svg.cost line { stroke: #7a776f; }
.dark .book-content svg.cost polyline:nth-of-type(3n + 1) { stroke: #fb923c; }
.dark .book-content svg.cost polyline:nth-of-type(3n + 2) { stroke: #7dd3fc; }
.dark .book-content svg.cost polyline:nth-of-type(3n + 3) { stroke: #4ade80; }
.dark .book-content svg.links rect { fill: #26251f; stroke: #8a8780; }
.dark .book-content svg.links text { fill: #e8e6e1; }
.dark .book-content svg.links line,
.dark .book-content svg.links path { stroke: #8a8780; }
.dark .book-content svg.links marker path { fill: #8a8780; stroke: none; }
/* The exercise card is a tinted panel, not a light one: in dark mode it takes
   a dark tint and keeps the site's foreground, instead of the light green
   CONTENT_CSS gives it, which left the prompt near-white on near-white. */
.dark .book-content .exercise { background: #0f1c14; border-left-color: #22c55e; }
.dark .book-content .exercise-title { color: #4ade80; }
/* The site's article rule strips horizontal padding from every \`pre\` for the
   blog's highlighted blocks, whose lines pad themselves. The book's blocks do
   not, so their own padding comes back — per kind, as CONTENT_CSS sets it. */
.book-content pre { padding-left: 16px !important; padding-right: 16px !important; }
.book-content pre.output { padding-left: 14px !important; padding-right: 14px !important; }
.book-content pre.code-hl { padding-left: 3.6em !important; padding-right: 12px !important; }
.book-content pre.code-gutter { padding-left: 0 !important; padding-right: 0 !important; }
.book-content h1, .book-content h2, .book-content h3 { font-weight: 700; }
.book-content p { margin: 1rem 0; }
.book-content ul { list-style: disc; margin: 1rem 0; padding-left: 1.4rem; }
.book-content ol { list-style: decimal; margin: 1rem 0; padding-left: 1.4rem; }
.book-content .cells, .book-content .hints { list-style: none; padding-left: 0; }
.book-content strong, .book-content b { font-weight: 700; }
.book-content em, .book-content i { font-style: italic; }
.book-content a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
.book-content figure.figure { overflow-x: auto; }
.book-content img, .book-content svg { max-width: 100%; }
`
// A challenge's side-by-side view. The panes come from the renderer (shared
// with the local preview): split, they are a fixed layer below the top bar,
// each scrolling on its own. The site says where its bar ends and which
// surface to paint in each look, and keeps the margin's collapsed overlay
// above the panes (the shared script collapses the rail while split).
//
// In `site` the book bar carrying the chapter progress is pinned under the
// site header; while split it is fixed there whatever the scroll position, and
// the shared script, which measures the stack of pinned bars, starts the panes
// below it. In `plain` the indicator is inside the plain bar, which the panes
// already start below.
const SPLIT_LAYOUT = `
html { --split-top: 4rem; --split-surface: hsl(var(--background)); --split-ink: hsl(var(--foreground)); }
html[data-book-look='plain'] { --split-top: var(--plain-bar-height); --split-surface: var(--plain-bg); --split-ink: var(--plain-ink); }
@media screen and (min-width: 1000px) {
  html[data-challenge-view='split'] .reading-shell:has([data-challenge-split]) .reading-margin {
    position: fixed;
    top: auto;
    right: 0;
    bottom: 0;
    width: 0;
    height: 0;
    min-height: 0;
    max-height: none;
    overflow: visible;
    z-index: 30;
  }
  html[data-challenge-view='split']:not([data-book-look='plain']):has([data-challenge-split]) .book-bar[data-has-progress] {
    position: fixed;
    top: 4.25rem;
    right: 0;
    left: 0;
    margin: 0;
  }
}
`
const manifest = bookManifest()
const style = `<style>${scopeContentCss(manifest.contentCss, '.book-content')}${RESTORED}${manifest.splitCss}${SPLIT_LAYOUT}${manifest.navCss}</style>`
---

<ReadingLayout
  title={`${node.title} — ${book.title}`}
  description={book.subtitle}
  documentUri={uri}
  canonicalPath={node.path}
  source={{ path: stamp.sourcePath, commit: stamp.sourceCommit, editDisabledReason: stamp.reason }}
>
  <Fragment slot="head" set:html={style} />

  <BookBar
    slot="before"
    book={book}
    currentId={node.id}
    progress={node.progress}
  />

  <Fragment slot="navigation">
    <BookContents book={book} currentId={node.id} />
  </Fragment>

  <EditMode />
  <div class="book-content" data-node={node.id} set:html={node.html} />
  <BookHistory page={{ site: new URL(uri).origin, document: uri, book: slug, node: nodeId, sourcePath: stamp.sourcePath, buildCommit: Astro.props.historyBuild }} />
  <script is:inline set:html={manifest.splitScript} />
  {
    grading && (
      <script type="application/json" data-book-grading={node.id} set:html={grading} />
    )
  }

  {
    sourceJson && (
      <script type="application/json" data-book-source={node.id} set:html={sourceJson} />
    )
  }

  <Fragment set:html={node.pager} />

  <BookProgress book={book} />
</ReadingLayout>

<script>
  // Everything on a book page that runs, as the local preview runs it (#380):
  // the editors, figures, cells, the challenge desk and its hints. The code
  // runs in the reader's own browser, in Python (Pyodide), graded by the same
  // Python files `grade.py` uses. The site swaps pages without a reload, so
  // this runs on every page view; anything already wired is left alone.
  import { wireEditors } from '../../../../books/tools/runtime/editor.mjs'
  import { wireInteractive } from '../../../../books/tools/runtime/interactive.mjs'
  import { cancelPython } from '../../../../books/tools/runtime/python.mjs'
  import {
    browserBackend,
    type BookGradingData,
  } from '../../../../books/tools/runtime/browser-backend.mjs'
  import bookgrader from '../../../../books/tools/bookgrader.py?raw'
  import graderObserve from '../../../../books/tools/grader_observe.py?raw'
  import gradingPy from '../../../../books/tools/grading.py?raw'
  import gradeInprocess from '../../../../books/tools/grade_inprocess.py?raw'
  import cellRunner from '../../../../books/tools/cell_runner.py?raw'

  const backend = browserBackend({
    sources: {
      'bookgrader.py': bookgrader,
      'grader_observe.py': graderObserve,
      'grading.py': gradingPy,
      'grade_inprocess.py': gradeInprocess,
      'cell_runner.py': cellRunner,
    },
    grading: (node) => {
      const data = document.querySelector(`script[data-book-grading="${CSS.escape(node)}"]`)
      return data?.textContent ? (JSON.parse(data.textContent) as BookGradingData) : null
    },
  })

  document.addEventListener('astro:page-load', () => {
    wireInteractive(document, backend)
    wireEditors(document)
  })
  // Python outlives a page swap; the last page's runs must not hold up this one's.
  document.addEventListener('astro:before-preparation', () => cancelPython())
</script>
