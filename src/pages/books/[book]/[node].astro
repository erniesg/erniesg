---
import BookBar from '@/components/books/BookBar.astro'
import BookContents from '@/components/books/BookContents.astro'
import BookProgress from '@/components/books/BookProgress.astro'
import EditMode from '@/components/books/EditMode.astro'
import ReadingLayout from '@/layouts/ReadingLayout.astro'
import { BOOK_CHROME_VARIABLES, RESTORED_BOOK_CSS } from '@/lib/book-page-css'
import {
  bookBySlug,
  bookManifest,
  books,
  documentUri,
  nodeSourceStamp,
  scopeContentCss,
} from '@/lib/books'

export function getStaticPaths() {
  return books().flatMap((book) =>
    book.nodes.map((node) => ({ params: { book: book.slug, node: node.id } })),
  )
}

const slug = Astro.params.book!
const nodeId = Astro.params.node!
const book = bookBySlug(slug)
if (!book) throw new Error(`no book path declares the slug \`${slug}\``)

const index = book.nodes.findIndex((entry) => entry.id === nodeId)
const node = book.nodes[index]
if (!node) throw new Error(`\`${slug}\` has no node \`${nodeId}\``)

// A challenge's tiers, for the grader in the reader's browser. `<` is escaped
// so a test file that mentions a closing script tag cannot end this one early.
const grading = node.grading ? JSON.stringify(node.grading).replace(/</g, '\\u003c') : null

const uri = documentUri(node.path)

// What this page was built from, for edit proposals (issue 059). The source
// text travels with the page so the editor diffs against exactly the commit it
// names; `<` is escaped for the same reason as the grading data above.
const stamp = nodeSourceStamp(node, import.meta.env.DEV)
const sourceJson = stamp.source === null
  ? null
  : JSON.stringify({ path: stamp.sourcePath, commit: stamp.sourceCommit, text: stamp.source }).replace(/</g, '\\u003c')

// A challenge's side-by-side view. The panes come from the renderer (shared
// with the local preview): split, they are a fixed layer below the top bar,
// each scrolling on its own. The site says where its bar ends and which
// surface to paint in each look, and keeps the margin's collapsed overlay
// above the panes (the shared script collapses the rail while split).
//
// In `site` the book bar carrying the chapter progress is pinned under the
// site header; while split it is fixed there whatever the scroll position, and
// the shared script, which measures the stack of pinned bars, starts the panes
// below it. In `plain` the indicator is inside the plain bar, which the panes
// already start below.
const SPLIT_LAYOUT = `
html { --split-top: 4rem; --split-surface: hsl(var(--background)); --split-ink: hsl(var(--foreground)); }
html[data-book-look='plain'] { --split-top: var(--plain-bar-height); --split-surface: var(--plain-bg); --split-ink: var(--plain-ink); }
@media screen and (min-width: 1000px) {
  html[data-challenge-view='split'] .reading-shell:has([data-challenge-split]) .reading-margin {
    position: fixed;
    top: auto;
    right: 0;
    bottom: 0;
    width: 0;
    height: 0;
    min-height: 0;
    max-height: none;
    overflow: visible;
    z-index: 30;
  }
  html[data-challenge-view='split']:not([data-book-look='plain']):has([data-challenge-split]) .book-bar[data-has-progress] {
    position: fixed;
    top: 4.25rem;
    right: 0;
    left: 0;
    margin: 0;
  }
}
`
const manifest = bookManifest()
const style = `<style>${scopeContentCss(manifest.contentCss, '.book-content')}${RESTORED_BOOK_CSS}${manifest.splitCss}${SPLIT_LAYOUT}${manifest.navCss}${BOOK_CHROME_VARIABLES}${manifest.railCss}</style>`
---

<ReadingLayout
  title={`${node.title} — ${book.title}`}
  description={book.subtitle}
  documentUri={uri}
  canonicalPath={node.path}
  source={{ path: stamp.sourcePath, commit: stamp.sourceCommit, editDisabledReason: stamp.reason }}
>
  <Fragment slot="head" set:html={style} />

  <BookBar
    slot="before"
    book={book}
    currentId={node.id}
    progress={node.progress}
  />

  <Fragment slot="navigation">
    <BookContents book={book} currentId={node.id} />
  </Fragment>

  {
    node.rail && (
      <div slot="companion" class="book-chrome" set:html={node.rail} />
    )
  }

  <EditMode />
  <div class="book-content" data-node={node.id} set:html={node.html} />
  <script is:inline set:html={manifest.splitScript} />
  {
    grading && (
      <script type="application/json" data-book-grading={node.id} set:html={grading} />
    )
  }

  {
    sourceJson && (
      <script type="application/json" data-book-source={node.id} set:html={sourceJson} />
    )
  }

  <Fragment set:html={node.pager} />

  <BookProgress book={book} />
</ReadingLayout>

<script>
  // Everything on a book page that runs, as the local preview runs it (#380):
  // the editors, figures, cells, the challenge desk and its hints. The code
  // runs in the reader's own browser, in Python (Pyodide), graded by the same
  // Python files `grade.py` uses. The site swaps pages without a reload, so
  // this runs on every page view; anything already wired is left alone.
  import { wireEditors } from '../../../../books/tools/runtime/editor.mjs'
  import { wireInteractive } from '../../../../books/tools/runtime/interactive.mjs'
  import { cancelPython } from '../../../../books/tools/runtime/python.mjs'
  import {
    browserBackend,
    type BookGradingData,
  } from '../../../../books/tools/runtime/browser-backend.mjs'
  import bookgrader from '../../../../books/tools/bookgrader.py?raw'
  import graderObserve from '../../../../books/tools/grader_observe.py?raw'
  import gradingPy from '../../../../books/tools/grading.py?raw'
  import gradeInprocess from '../../../../books/tools/grade_inprocess.py?raw'
  import cellRunner from '../../../../books/tools/cell_runner.py?raw'

  const backend = browserBackend({
    sources: {
      'bookgrader.py': bookgrader,
      'grader_observe.py': graderObserve,
      'grading.py': gradingPy,
      'grade_inprocess.py': gradeInprocess,
      'cell_runner.py': cellRunner,
    },
    grading: (node) => {
      const data = document.querySelector(`script[data-book-grading="${CSS.escape(node)}"]`)
      return data?.textContent ? (JSON.parse(data.textContent) as BookGradingData) : null
    },
  })

  document.addEventListener('astro:page-load', () => {
    wireInteractive(document, backend)
    wireEditors(document)
  })
  // Python outlives a page swap; the last page's runs must not hold up this one's.
  document.addEventListener('astro:before-preparation', () => cancelPython())
</script>
