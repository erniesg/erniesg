---
/**
 * Every annotation the signed-in reader has made in one book, on one page
 * (issue 073), grouped by chapter in the book's order, each linking back to
 * its spot with `annotation=<id>`.
 *
 * Static, like every book page: what is built here is the book's shape (its
 * pages, titles and order, from the manifest); the reader's annotations are
 * fetched in the browser from `GET /api/margin/v1/mine`, which returns only
 * the caller's own. Filtering is in the browser too; nothing new is stored.
 *
 * Everything that came from storage is inserted as text, never as markup:
 * quotes, bodies, sketch notes, names, and above all a foreign parent's
 * quote and body, which another reader wrote.
 *
 * The page mounts no margin of its own: it is about annotations, not
 * something to annotate.
 */
import BookBar from '@/components/books/BookBar.astro'
import BookContents from '@/components/books/BookContents.astro'
import ReadingLayout from '@/layouts/ReadingLayout.astro'
import { SITE } from '@/consts'
import { bookBySlug, books, documentUri } from '@/lib/books'
import type { OverviewPage } from '@/lib/annotations-overview'

export function getStaticPaths() {
  return books().map((book) => ({ params: { book: book.slug } }))
}

const slug = Astro.params.book!
const book = bookBySlug(slug)
if (!book) throw new Error(`no book path declares the slug \`${slug}\``)

const path = `${book.path}annotations/`
const first = book.nodes[0]
// The book's shape: its front page, and its nodes in reading order. Anything
// else under the prefix (the map, a page since removed) is "Other pages".
const nodes: OverviewPage[] = book.nodes.map((node) => ({
  id: node.id,
  title: node.title,
  path: node.path,
}))
// `<` is escaped so no title can end this script early.
const data = JSON.stringify({
  site: new URL(SITE.SITEURL).origin,
  prefix: book.path,
  path,
  frontPage: book.path,
  nodes,
  first: first ? { title: first.title, path: first.path } : null,
}).replace(/</g, '\\u003c')
---

<ReadingLayout
  title={`Your annotations — ${book.title}`}
  description={`Every highlight, note, sketch and edit proposal you have made in ${book.title}.`}
  documentUri={documentUri(path)}
  canonicalPath={path}
  marginDefault="none"
  noindex
>
  <BookBar slot="before" book={book} />

  <Fragment slot="navigation">
    <BookContents book={book} />
  </Fragment>

  <section class="annotations-overview" data-annotations-overview>
    <header class="annotations-head">
      <h1>Your annotations</h1>
      <p>
        Everything you have highlighted, noted, sketched or proposed in
        <a href={book.path}>{book.title}</a>, chapter by chapter. Only you see
        this list.
      </p>
    </header>

    <div class="annotations-filters" data-annotations-filters hidden>
      <label>
        <span>Kind</span>
        <select name="kind" data-filter-kind>
          <option value="all">Everything</option>
          <option value="highlight">Highlights</option>
          <option value="note">Notes</option>
          <option value="sketch">Sketches</option>
          <option value="proposal">Proposals</option>
        </select>
      </label>
      <label>
        <span>Chapter</span>
        <select name="chapter" data-filter-chapter>
          <option value="all">All chapters</option>
        </select>
      </label>
    </div>

    <p class="annotations-status" data-annotations-status role="status">
      Loading your annotations…
    </p>
    <div class="annotations-problem" data-annotations-problem role="alert" hidden>
      <p data-annotations-problem-text></p>
      <button type="button" data-annotations-retry>Retry</button>
    </div>
    <p class="annotations-status" data-annotations-filter-empty hidden>
      Nothing here matches those filters.
    </p>
    <div data-annotations-list></div>
  </section>
  <script type="application/json" data-annotations-data set:html={data} />
</ReadingLayout>

<script>
  import {
    buildOverview,
    DELETED_NOTE_LABEL,
    fetchMine,
    KIND_LABELS,
    linkTo,
    matchesFilter,
    OTHER_PAGES_ID,
    parentRequestUrl,
    PROPOSAL_STATE_LABELS,
    resolveForeignParent,
    UNPARSED_PROPOSAL,
    type OverviewEntry,
    type OverviewFilter,
    type OverviewGroup,
    type OverviewPage,
    type WireAnnotation,
  } from '@/lib/annotations-overview'
  import { ROLE_PALETTE } from '../../../../packages/margin/src/palette'
  import { createSketchSvg, previewAspectRatio } from '../../../../packages/margin/src/sketch'

  type PageData = {
    site: string
    prefix: string
    path: string
    frontPage: string
    nodes: OverviewPage[]
    first: { title: string; path: string } | null
  }

  const LOAD_FAILED = 'Could not load your annotations.'
  /** How long `/auth/me` may take before the page stops waiting and says so. */
  const AUTH_TIMEOUT_MS = 10_000
  const LOAD_INCOMPLETE =
    'Some of your annotations could not be loaded, so this list is incomplete.'

  /** Every node this page makes holds text, set as text: nothing is parsed as markup. */
  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    attributes: Record<string, string> = {},
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag)
    for (const [name, value] of Object.entries(attributes)) node.setAttribute(name, value)
    if (text !== undefined) node.textContent = text
    return node
  }

  const DATE = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' })

  function when(iso: string): HTMLTimeElement {
    const time = el('time', { datetime: iso })
    const date = new Date(iso)
    time.textContent = Number.isNaN(date.getTime()) ? iso : DATE.format(date)
    return time
  }

  function source(entry: OverviewEntry): string {
    const value = entry.wire.target?.source
    return typeof value === 'string' ? value : ''
  }

  /** The reader's replies, in the rail's flattened order, each linking to itself. */
  function renderThread(entry: OverviewEntry): HTMLOListElement | null {
    if (entry.thread.length === 0) return null
    const list = el('ol', {
      class: 'annotations-replies',
      'data-entry-replies': '',
      'aria-label': 'Your replies',
    })
    for (const { reply, indent } of entry.thread) {
      const item = el('li', { 'data-reply': reply.serverId, 'data-depth': String(indent) })
      item.style.setProperty('--indent', String(indent))
      item.append(
        el('span', { class: reply.deleted ? 'annotations-deleted' : '', 'data-reply-body': '' }, reply.body),
        ' ',
        el('a', { href: linkTo(source(entry), reply.serverId), 'data-reply-link': '' }, 'Go to it'),
      )
      list.append(item)
    }
    return list
  }

  function swatch(color: { role: string; label: string }): HTMLSpanElement {
    const span = el(
      'span',
      { class: 'annotations-swatch', 'data-entry-color': '', 'data-role': color.role },
      color.label,
    )
    span.style.setProperty('--swatch', ROLE_PALETTE[color.role as keyof typeof ROLE_PALETTE])
    return span
  }

  function renderOwn(entry: OverviewEntry): HTMLLIElement {
    const fields = entry.fields!
    const deleted = fields.kind === 'note' && fields.deleted
    const item = el('li', {
      class: 'annotations-entry',
      'data-annotation-entry': entry.id,
      'data-kind': entry.kind,
    })
    const meta = el('p', { class: 'annotations-meta' })
    meta.append(
      el(
        'span',
        { class: 'annotations-kind', 'data-entry-kind': '' },
        deleted ? DELETED_NOTE_LABEL : KIND_LABELS[entry.kind],
      ),
    )
    if (fields.kind === 'highlight') {
      item.style.setProperty('--swatch', ROLE_PALETTE[fields.color.role])
      meta.append(swatch(fields.color))
    }
    if (fields.kind === 'note' && !fields.deleted && fields.color) {
      item.style.setProperty('--swatch', ROLE_PALETTE[fields.color.role])
      meta.append(swatch(fields.color))
    }
    if (fields.kind === 'proposal') {
      meta.append(
        el(
          'span',
          { class: 'annotations-state', 'data-proposal-state': fields.state },
          PROPOSAL_STATE_LABELS[fields.state],
        ),
      )
    }
    meta.append(when(entry.created))
    item.append(meta)

    if (entry.quote) item.append(el('blockquote', { 'data-entry-quote': '' }, entry.quote))
    if (fields.kind === 'sketch') {
      const svg = createSketchSvg(fields.sketch, document)
      svg.setAttribute('class', 'annotations-sketch')
      // The rail's own rule, so a stored region cannot stretch this page either.
      svg.style.aspectRatio = previewAspectRatio(fields.sketch.region)
      item.append(svg, el('p', { class: 'annotations-body', 'data-entry-body': '' }, fields.note))
    }
    if (fields.kind === 'note' && !fields.deleted) {
      item.append(el('p', { class: 'annotations-body', 'data-entry-body': '' }, fields.body))
    }
    if (fields.kind === 'proposal') {
      item.append(
        el(
          'p',
          { class: 'annotations-body', 'data-proposal-summary': fields.summary === null ? 'none' : '' },
          fields.summary ?? UNPARSED_PROPOSAL,
        ),
      )
    }
    const thread = renderThread(entry)
    if (thread) item.append(thread)
    item.append(el('a', { href: entry.href, 'data-annotation-link': '' }, 'Go to it →'))
    return item
  }

  /**
   * Somebody else's annotation with the reader's replies under it: once the
   * page has asked for it, shown as theirs; if it could not be read, the
   * reader's replies stand on their own. Only the one parent is shown; a
   * parent that is itself a reply links to its whole thread at its spot.
   */
  function renderForeign(entry: OverviewEntry): HTMLLIElement {
    const parent = entry.foreign!
    const item = el('li', {
      class: 'annotations-entry',
      'data-annotation-entry': entry.id,
      'data-kind': entry.kind,
      'data-foreign-parent': parent.state,
    })
    const meta = el('p', { class: 'annotations-meta' })
    if (parent.state === 'visible') {
      meta.append(
        el('span', { class: 'annotations-kind', 'data-entry-kind': '' }, parent.deleted ? DELETED_NOTE_LABEL : KIND_LABELS.note),
        el(
          'span',
          { class: 'annotations-someone', 'data-someone-elses': '' },
          `${parent.creatorName}'s ${parent.isReply ? 'reply' : 'note'}, not yours`,
        ),
      )
    } else {
      meta.append(el('span', { class: 'annotations-kind', 'data-entry-kind': '' }, 'Your reply'))
    }
    meta.append(when(entry.created))
    item.append(meta)
    if (entry.quote) item.append(el('blockquote', { 'data-entry-quote': '' }, entry.quote))
    if (parent.state === 'visible') {
      if (parent.body !== null) {
        item.append(el('p', { class: 'annotations-body', 'data-entry-body': '' }, parent.body))
      }
      if (parent.isReply) {
        item.append(el('a', { href: parent.threadHref, 'data-thread-link': '' }, 'See the whole thread →'))
      }
    } else if (parent.state === 'failed') {
      item.append(
        el(
          'p',
          { class: 'annotations-body annotations-quiet', 'data-foreign-failed': '' },
          'The note this answers could not be loaded just now.',
        ),
      )
    }
    const thread = renderThread(entry)
    if (thread) item.append(thread)
    item.append(el('a', { href: entry.href, 'data-annotation-link': '' }, 'Go to your reply →'))
    return item
  }

  function renderEntry(entry: OverviewEntry, showPage: boolean): HTMLLIElement {
    const item = entry.foreign ? renderForeign(entry) : renderOwn(entry)
    // In "Other pages" the group does not say which page; the entry does.
    if (showPage) {
      item
        .querySelector('.annotations-meta')
        ?.append(el('a', { href: entry.path, 'data-entry-page': '' }, entry.path))
    }
    return item
  }

  function renderGroups(list: HTMLElement, groups: OverviewGroup[]) {
    list.replaceChildren(
      ...groups.map((group) => {
        const section = el('section', {
          class: 'annotations-chapter',
          'data-annotations-chapter': group.page.id,
        })
        const heading = el('h2')
        if (group.page.path) heading.append(el('a', { href: group.page.path }, group.page.title))
        else heading.textContent = group.page.title
        const other = group.page.id === OTHER_PAGES_ID
        const entries = el('ol', { class: 'annotations-entries' })
        entries.append(...group.entries.map((entry) => renderEntry(entry, other)))
        section.append(heading, entries)
        return section
      }),
    )
  }

  /**
   * Parent lookups, cached per `(source, parentId)` for the page's life, so
   * any number of replies to one parent, and any number of redraws, cost one
   * request.
   */
  const parentLookups = new Map<string, Promise<{ status: number; body: unknown } | null>>()

  function lookUpParent(entry: OverviewEntry): Promise<{ status: number; body: unknown } | null> {
    const key = `${source(entry)}\n${entry.foreign?.id ?? entry.id}`
    let lookup = parentLookups.get(key)
    if (!lookup) {
      lookup = fetch(parentRequestUrl(entry), {
        credentials: 'include',
        headers: { accept: 'application/json' },
      })
        .then(async (response) => ({ status: response.status, body: await response.json().catch(() => null) }))
        .catch(() => null)
      parentLookups.set(key, lookup)
      // A failure is not remembered: Retry, or the next render, asks again.
      void lookup.then((answer) => {
        if (!answer || answer.status < 200 || answer.status > 299) parentLookups.delete(key)
      })
    }
    return lookup
  }

  /**
   * Ask for each foreign parent through the visibility-scoped read, scoped by
   * the reader's own reply's source, and redraw its entry with the answer.
   * `/mine` itself stays the reader's own rows only.
   */
  async function resolveForeign(groups: OverviewGroup[], isCurrent: () => boolean) {
    const entries = groups.flatMap((group) =>
      group.entries
        .filter((entry) => entry.foreign?.state === 'pending')
        .map((entry) => ({ entry, other: group.page.id === OTHER_PAGES_ID })),
    )
    await Promise.all(
      entries.map(async ({ entry, other }) => {
        const answer = await lookUpParent(entry)
        if (!isCurrent()) return
        resolveForeignParent(entry, answer)
        const current = document.querySelector<HTMLElement>(
          `[data-annotation-entry="${CSS.escape(entry.id)}"]`,
        )
        if (!current) return
        const next = renderEntry(entry, other)
        next.hidden = current.hidden
        current.replaceWith(next)
      }),
    )
  }

  function applyFilter(root: HTMLElement, groups: OverviewGroup[], filter: OverviewFilter) {
    let shown = 0
    for (const group of groups) {
      const section = root.querySelector<HTMLElement>(
        `[data-annotations-chapter="${CSS.escape(group.page.id)}"]`,
      )
      let inSection = 0
      for (const entry of group.entries) {
        const item = section?.querySelector<HTMLElement>(
          `[data-annotation-entry="${CSS.escape(entry.id)}"]`,
        )
        const visible = matchesFilter(entry, group.page, filter)
        if (item) item.hidden = !visible
        if (visible) inSection += 1
      }
      if (section) section.hidden = inSection === 0
      shown += inSection
    }
    const empty = root.querySelector<HTMLElement>('[data-annotations-filter-empty]')
    if (empty) empty.hidden = shown > 0
  }

  /**
   * Who is reading. Only a successful `/auth/me` that names nobody is signed
   * out; an error status, a timeout or a body that is not the expected JSON
   * is a failure to find out, which the page says, with Retry, rather than
   * asking someone who may well be signed in to sign in.
   */
  async function reader(): Promise<'signed-in' | 'signed-out' | 'failed'> {
    const abort = new AbortController()
    const timer = window.setTimeout(() => abort.abort(), AUTH_TIMEOUT_MS)
    try {
      const response = await fetch('/auth/me', {
        credentials: 'include',
        headers: { accept: 'application/json' },
        signal: abort.signal,
      })
      if (!response.ok) return 'failed'
      const me = (await response.json()) as unknown
      if (!me || typeof me !== 'object' || Array.isArray(me)) return 'failed'
      return (me as { principal?: unknown }).principal ? 'signed-in' : 'signed-out'
    } catch {
      return 'failed'
    } finally {
      window.clearTimeout(timer)
    }
  }

  // Each page view renders at most once, onto its own page.
  let visit = 0
  document.addEventListener('astro:before-preparation', () => {
    visit += 1
  })
  document.addEventListener('astro:page-load', async () => {
    const root = document.querySelector<HTMLElement>('[data-annotations-overview]')
    const holder = document.querySelector<HTMLScriptElement>('[data-annotations-data]')
    if (!root || !holder?.textContent) return
    const mine = ++visit
    const isCurrent = () => mine === visit
    const data = JSON.parse(holder.textContent) as PageData
    const status = root.querySelector<HTMLElement>('[data-annotations-status]')!
    const problem = root.querySelector<HTMLElement>('[data-annotations-problem]')!
    const problemText = root.querySelector<HTMLElement>('[data-annotations-problem-text]')!
    const retry = root.querySelector<HTMLButtonElement>('[data-annotations-retry]')!
    const list = root.querySelector<HTMLElement>('[data-annotations-list]')!
    const filters = root.querySelector<HTMLElement>('[data-annotations-filters]')!
    const kind = filters.querySelector<HTMLSelectElement>('[data-filter-kind]')!
    const chapter = filters.querySelector<HTMLSelectElement>('[data-filter-chapter]')!

    const showSignIn = () => {
      problem.hidden = true
      status.replaceChildren(
        el('a', { href: `/auth/login?return_to=${encodeURIComponent(data.path)}` }, 'Sign in to see your annotations'),
        '.',
      )
    }

    const showFailure = () => {
      // Nothing is known, which is not the same as nothing there.
      status.textContent = ''
      problemText.textContent = LOAD_FAILED
      problem.hidden = false
      root.setAttribute('data-annotations-state', 'failed')
    }

    // What has loaded so far, and where a partial load stopped.
    let rows: WireAnnotation[] = []
    let resumeAt: string | undefined
    let groups: OverviewGroup[] = []

    const update = () =>
      applyFilter(root, groups, { kind: kind.value as OverviewFilter['kind'], page: chapter.value })
    kind.addEventListener('change', update)
    chapter.addEventListener('change', update)

    const render = async () => {
      groups = buildOverview(rows, { frontPage: data.frontPage, nodes: data.nodes })
      if (groups.length === 0) {
        list.replaceChildren()
        filters.hidden = true
        status.replaceChildren('You have no annotations in this book yet.')
        if (data.first) {
          status.append(
            ' Start with ',
            el('a', { href: data.first.path }, data.first.title),
            ': select any passage to highlight it or add a note.',
          )
        }
        return
      }
      const count = groups.reduce((total, group) => total + group.entries.length, 0)
      status.textContent = `${count} ${count === 1 ? 'annotation' : 'annotations'} in ${groups.length} ${groups.length === 1 ? 'place' : 'places'}.`
      renderGroups(list, groups)
      const chosen = chapter.value
      chapter.replaceChildren(
        el('option', { value: 'all' }, 'All chapters'),
        ...groups.map((group) => el('option', { value: group.page.id }, group.page.title)),
      )
      chapter.value = groups.some((group) => group.page.id === chosen) ? chosen : 'all'
      filters.hidden = false
      update()
      await resolveForeign(groups, isCurrent)
    }

    // Whether `/auth/me` has said who is reading yet.
    let known = false

    const load = async () => {
      retry.disabled = true
      try {
        if (!known) {
          const who = await reader()
          if (!isCurrent()) return
          if (who === 'failed') return showFailure()
          if (who === 'signed-out') return showSignIn()
          known = true
        }
        const result = await fetchMine(data.site, data.prefix, undefined, resumeAt)
        if (!isCurrent()) return
        if (result.status === 'signed-out') return showSignIn()
        if (result.status === 'failed') return showFailure()
        await settle(result)
      } finally {
        retry.disabled = false
      }
    }

    const settle = async (result: Exclude<Awaited<ReturnType<typeof fetchMine>>, { status: 'failed' | 'signed-out' }>) => {
      rows = [...rows, ...result.annotations]
      if (result.status === 'partial') {
        resumeAt = result.cursor
        problemText.textContent = LOAD_INCOMPLETE
        problem.hidden = false
        root.setAttribute('data-annotations-state', 'incomplete')
      } else {
        resumeAt = undefined
        problem.hidden = true
        root.setAttribute('data-annotations-state', 'complete')
      }
      await render()
    }

    retry.addEventListener('click', () => void load())
    await load()
  })
</script>


<style is:global>
  .annotations-overview {
    display: grid;
    gap: 1.25rem;
    overflow-wrap: anywhere;
  }

  .annotations-head h1 {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .annotations-head p {
    margin-top: 0.5rem;
    color: hsl(var(--muted-foreground));
  }

  .annotations-overview a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .annotations-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .annotations-filters[hidden] {
    display: none;
  }

  .annotations-filters label {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    font-size: 0.8125rem;
  }

  .annotations-filters select {
    max-width: 100%;
    padding: 0.3rem 0.5rem;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .annotations-filters option {
    color: initial;
  }

  .annotations-status {
    font-size: 0.9375rem;
  }

  .annotations-status[hidden],
  .annotations-chapter[hidden],
  .annotations-entry[hidden] {
    display: none;
  }

  [data-annotations-list] {
    display: grid;
    gap: 2rem;
  }

  .annotations-chapter h2 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .annotations-chapter h2 a {
    color: inherit;
    text-decoration: none;
  }

  .annotations-chapter h2 a:hover {
    text-decoration: underline;
  }

  .annotations-entries {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .annotations-entry {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-left: 4px solid var(--swatch, color-mix(in srgb, currentColor 35%, transparent));
    border-radius: 6px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .annotations-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
  }

  .annotations-kind {
    color: hsl(var(--foreground));
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .annotations-swatch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .annotations-swatch::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: var(--swatch);
  }

  .annotations-state {
    padding: 0.05rem 0.4rem;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .annotations-someone {
    font-style: italic;
  }

  .annotations-entry blockquote {
    margin: 0;
    padding-left: 0.75rem;
    border-left: 2px solid color-mix(in srgb, currentColor 25%, transparent);
    font-style: italic;
  }

  .annotations-body {
    margin: 0;
    white-space: pre-wrap;
  }

  pre.annotations-body {
    overflow-x: auto;
    max-width: 100%;
    padding: 0.5rem 0.6rem;
    border-radius: 4px;
    background: color-mix(in srgb, currentColor 6%, transparent);
    font-size: 0.8125rem;
  }

  .annotations-deleted {
    font-style: italic;
    opacity: 0.75;
  }

  .annotations-sketch {
    display: block;
    width: min(100%, 14rem);
