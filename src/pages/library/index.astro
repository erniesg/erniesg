---
/**
 * `/library`: other people's work that the owner is reading (ADR 010).
 *
 * This is the one route that renders the browser importer. It replaced two
 * identical copies — `/research/studio` and `/study/experiments/pdf-to-epub` —
 * and both of those, with `/research/pdf-review`, now redirect here.
 *
 * The importer is the "add a document" path and it is kept on purpose: it
 * never uploads the file, which is the property that matters for reading
 * somebody else's book.
 */
import PublicationImporter from '@/components/research/PublicationImporter'
import { SITE } from '@/consts'
import ReadingLayout from '@/layouts/ReadingLayout.astro'

// The production release gate withholds the benchmark queue
// (`tools/deployment/release-gate.mjs`), so a production page must not link
// to it.
const showBenchmark = import.meta.env.PUBLIC_RESEARCH_RELEASE !== 'production'
---

<ReadingLayout
  title="Library"
  description="Add a document to read: convert a PDF into a reflowable EPUB in your browser. Your file stays on this device."
  documentUri={new URL('/library/', SITE.SITEURL).toString()}
  canonicalPath="/library/"
  noindex
>
  <Fragment slot="navigation">
    <ul class="flex flex-col gap-y-2 text-sm">
      <li><a class="hover:underline" href="#add-a-document">Add a document</a></li>
      {
        showBenchmark && (
          <li>
            <a class="hover:underline" href="/library/pdf-review/">
              Review the 20-paper benchmark
            </a>
          </li>
        )
      }
    </ul>
  </Fragment>

  <div class="flex flex-col gap-y-8 pb-24">
    <header class="flex flex-col gap-y-3 border-b pb-6">
      <h1 class="text-3xl font-bold">Library</h1>
      <p class="text-sm leading-relaxed text-muted-foreground">
        Other people's work, read here. Upload a paper or paste a direct PDF
        link to add it. The conversion runs in your browser, and your file stays
        on this device.
      </p>
      {
        showBenchmark && (
          <a
            class="w-fit text-sm font-medium underline underline-offset-4"
            href="/library/pdf-review/"
          >
            Review the 20-paper benchmark →
          </a>
        )
      }
    </header>
    <section
      id="add-a-document"
      class="flex flex-col gap-y-4"
      aria-labelledby="add-a-document-heading"
    >
      <h2 id="add-a-document-heading" class="text-2xl font-semibold">
        PDF to EPUB
      </h2>
      <PublicationImporter showIntro={false} client:load />
    </section>
  </div>
</ReadingLayout>
