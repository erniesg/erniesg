---
import ResearchStudio from '@/components/research/ResearchStudio'
import Layout from '@/layouts/Layout.astro'
import { papers } from '@/research/papers'

export function getStaticPaths() {
  return papers.map((paper) => ({ params: { id: paper.id }, props: { paper } }))
}

const { paper } = Astro.props
---

<Layout title={paper.title} description={paper.abstract}>
  <section class="research-paper-hero">
    <a href="/research">← All research</a>
    <div>
      <p>Research note 001 · {paper.status}</p>
      <h1>{paper.title}</h1>
      <p>{paper.subtitle}</p>
    </div>
    <nav aria-label="Paper downloads">
      <button onclick="window.print()">Print / PDF</button>
      <a href={`/research/${paper.id}/source.json`}>Source JSON</a>
    </nav>
  </section>
  <ResearchStudio paper={paper} client:load />
</Layout>
