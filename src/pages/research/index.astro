---
import Container from '@/components/Container.astro'
import ResearchProjects from '@/components/research/ResearchProjects.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout title="Research" description="Research papers and work in progress.">
  <Container class="flex flex-col gap-y-12 pb-24">
    <header class="flex flex-col gap-y-3 border-b pb-6">
      <h1 class="text-3xl font-bold" data-i18n-key="nav.research">Research</h1>
      <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Research papers and work in progress.
      </p>
    </header>

    <ResearchProjects />
  </Container>
</Layout>
