---
import Container from '@/components/Container.astro'
import ResearchProjects from '@/components/research/ResearchProjects.astro'
import Layout from '@/layouts/Layout.astro'
import { papers } from '@/research/papers'
const showLibrary = import.meta.env.PUBLIC_RESEARCH_RELEASE !== 'production'
---

<Layout
  title="Research"
  description="Research papers, ongoing and finished alike."
>
  <Container class="flex flex-col gap-y-12 pb-24">
    <header class="flex flex-col gap-y-3 border-b pb-6">
      <h1 class="text-3xl font-bold" data-i18n-key="nav.research">Research</h1>
      <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Research in progress and finished, for reading across screens and e-ink.
        {
          showLibrary && (
            <span>
              To read somebody else's paper, add it to the{' '}
              <a class="underline underline-offset-4" href="/library/">
                library
              </a>
              .
            </span>
          )
        }
      </p>
    </header>

    <ResearchProjects />

    <section class="flex flex-col gap-y-4" aria-labelledby="research-papers">
      <h2 id="research-papers" class="text-2xl font-semibold">
        Research papers
      </h2>
      <ul class="border-t">
        {
          papers.map((paper) => (
            <li class="border-b py-6">
              <a
                class="group flex flex-col gap-y-2"
                href={`/research/${paper.id}/`}
              >
                <small class="text-xs text-muted-foreground">
                  {paper.status} · Updated {paper.updated}
                </small>
                <h3 class="text-xl font-semibold group-hover:underline group-hover:underline-offset-4">
                  {paper.title}
                </h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                  {paper.abstract}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
