---
import Container from '@/components/Container.astro'
import PrivatePdfEpubBridge from '@/components/research/PrivatePdfEpubBridge'
import Layout from '@/layouts/Layout.astro'
---

<Layout
  title="Local private PDF to EPUB"
  description="A local-only, owner-private PDF to safe EPUB bridge."
  canonicalPath="/research/private-pdf-epub"
  noindex
>
  <Container class="flex flex-col gap-y-8 pb-24">
    <header class="flex flex-col gap-y-3 border-b pb-6">
      <h1 class="text-3xl font-bold">Local private PDF to EPUB</h1>
      <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
        This unlisted research surface is local-only. The production release
        gate removes every <code>/research</code> route.
      </p>
    </header>

    <PrivatePdfEpubBridge client:load />
  </Container>
</Layout>
