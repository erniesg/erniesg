{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "erniesg-workers",
  "compatibility_date": "2026-07-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ernie.sg/*",
      "zone_name": "ernie.sg",
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
